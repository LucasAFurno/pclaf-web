---
import SiteLayout from '../layouts/SiteLayout.astro';
import PclafHeader from './PclafHeader.astro';
interface Props { title: string; accent: string; eyebrow?: string; description: string; items: string[]; video?: string; }
const { title, accent, eyebrow='PCLAF / SERVICIO', description, items, video='/assets/pc-motherboard-loop.mp4' } = Astro.props;
---
<SiteLayout title={`${title} | PCLAF`} description={description}><div class="modern-service"><PclafHeader /><main><section class="service-hero"><video autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src={video} type="video/mp4" /></video><div class="shade"></div><div class="service-hero-copy"><p class="eyebrow">{eyebrow}</p><h1>{title}<br /><em>{accent}</em></h1><p class="lead">{description}</p><div class="actions"><a class="red" href="/turnos.html">Pedir turno ↗</a><a class="line" href="/historial.html">Ver reparación ↗</a></div></div></section><section class="service-body"><div class="body-head"><p class="eyebrow">QUÉ INCLUYE</p><h2>Un trabajo claro,<br /><em>sin vueltas.</em></h2></div><div class="items">{items.map((item,index)=><article><span>0{index+1}</span><h3>{item}</h3><p>Revisamos el equipo, te explicamos qué encontramos y avanzamos con tu aprobación.</p></article>)}</div></section><section class="service-cta"><p class="eyebrow">¿LO VEMOS?</p><h2>Hacé que vuelva<br /><em>a funcionar.</em></h2><a href="/turnos.html">Agendar diagnóstico ↗</a></section></main><footer><span>© 2026 PCLAF / FLORES · FLORESTA</span><a href="/pclaf-nuevo.html">Volver al inicio ↗</a></footer></div></SiteLayout>
<style>
:global(:root){--bg:#151719;--ink:#f2eee7;--red:#e12b24;--green:#53d88e;--muted:#aaa39b;--line:#3d4143;--mono:'DM Mono',monospace;--sans:'Space Grotesk',sans-serif}:global(*){box-sizing:border-box}:global(body){margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans)}:global(a){color:inherit;text-decoration:none}.service-hero{min-height:570px;position:relative;overflow:hidden}.service-hero video,.shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.service-hero video{opacity:.45;filter:saturate(.7)}.shade{background:linear-gradient(90deg,rgba(10,11,12,.95),rgba(10,11,12,.62) 62%,rgba(10,11,12,.1))}.service-hero-copy{position:relative;padding:clamp(90px,12vw,160px) clamp(20px,8vw,140px)}.eyebrow{font:10px var(--mono);letter-spacing:.13em;color:var(--red);text-transform:uppercase}.service-hero h1,.body-head h2,.service-cta h2{font-size:clamp(60px,8vw,110px);line-height:.84;letter-spacing:-.1em;font-weight:500;margin:30px 0 0}.service-hero h1 em,.body-head h2 em,.service-cta h2 em{font-style:italic;color:var(--red)}.lead{max-width:590px;color:#d0cbc3;font-size:19px;line-height:1.5;margin:32px 0}.actions{display:flex;gap:10px;margin-top:28px}.actions a,.service-cta a{font:11px var(--mono);letter-spacing:.08em;text-transform:uppercase;padding:16px 20px}.red,.service-cta a{background:var(--red);color:#fff}.line{border:1px solid #707476}.service-body{padding:110px clamp(20px,8vw,140px)}.body-head{display:grid;grid-template-columns:.6fr 1.4fr;margin-bottom:60px}.body-head h2{margin:0;font-size:clamp(54px,7vw,92px)}.items{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line)}.items article{min-height:180px;border-bottom:1px solid var(--line);padding:24px 28px 28px 0}.items article:nth-child(odd){border-right:1px solid var(--line);padding-right:40px}.items article:nth-child(even){padding-left:40px}.items span{font:10px var(--mono);color:var(--red)}.items h3{font-size:28px;font-weight:500;margin:24px 0 10px}.items p{margin:0;max-width:410px;color:var(--muted);line-height:1.5}.service-cta{padding:80px clamp(20px,8vw,140px);background:#0d0f10;border-top:1px solid var(--line)}.service-cta h2{margin:23px 0 35px}.modern-service footer{display:flex;justify-content:space-between;padding:24px clamp(20px,8vw,140px);font:10px var(--mono);color:var(--muted);border-top:1px solid var(--line)}.modern-service footer a{color:var(--ink)}@media(max-width:700px){.body-head,.items{grid-template-columns:1fr}.items article:nth-child(odd),.items article:nth-child(even){border-right:0;padding:24px 0}.service-hero h1{font-size:58px}.actions{flex-wrap:wrap}.modern-service footer{flex-direction:column;gap:14px}}
</style>
