---
import SiteLayout from '../layouts/SiteLayout.astro';
import PclafHeader from './PclafHeader.astro';
interface Props { title:string; accent:string; eyebrow:string; description:string; cards:{title:string; text:string}[]; }
const {title,accent,eyebrow,description,cards}=Astro.props;
---
<SiteLayout title={`${title} | PCLAF`} description={description}><div class="info-page"><PclafHeader /><main><section class="info-hero"><p class="eyebrow">{eyebrow}</p><h1>{title}<br /><em>{accent}</em></h1><p>{description}</p></section><section class="info-grid">{cards.map((card,index)=><article><span>0{index+1}</span><h2>{card.title}</h2><p>{card.text}</p></article>)}</section><section class="info-cta"><p class="eyebrow">PCLAF / PRÓXIMO PASO</p><h2>Elegí cómo<br /><em>seguimos.</em></h2><div><a href="/turnos.html">Pedir turno ↗</a><a href="/pclaf-nuevo.html#servicios">Ver servicios ↗</a></div></section></main><footer><span>PCLAF / BUENOS AIRES</span><a href="/pclaf-nuevo.html">Volver al inicio ↗</a></footer></div></SiteLayout>
<style>
:global(:root){--bg:#151719;--ink:#f2eee7;--red:#e12b24;--green:#53d88e;--muted:#aaa39b;--line:#3d4143;--mono:'DM Mono',monospace;--sans:'Space Grotesk',sans-serif}:global(*){box-sizing:border-box}:global(body){margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans)}:global(a){color:inherit;text-decoration:none}.info-page{min-height:100vh;background:radial-gradient(circle at 82% 18%,rgba(225,43,36,.12),transparent 30%),var(--bg)}.info-hero{padding:clamp(90px,13vw,165px) clamp(20px,8vw,140px) 100px;border-bottom:1px solid var(--line)}.eyebrow{font:10px var(--mono);letter-spacing:.13em;color:var(--red);text-transform:uppercase}.info-hero h1,.info-cta h2{font-size:clamp(64px,9vw,122px);line-height:.84;letter-spacing:-.1em;font-weight:500;margin:35px 0}.info-hero h1 em,.info-cta h2 em{color:var(--red);font-style:italic}.info-hero>p:last-child{max-width:570px;color:#c7c4bd;font-size:20px;line-height:1.5}.info-grid{max-width:1120px;margin:auto;padding:80px 24px 120px;display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.info-grid article{min-height:220px;border:1px solid var(--line);padding:25px;background:#1a1c1e}.info-grid article:nth-child(2){background:var(--red);border-color:var(--red);color:#fff}.info-grid span{font:10px var(--mono);color:var(--green)}.info-grid article:nth-child(2) span{color:#390a08}.info-grid h2{font-size:34px;font-weight:500;margin:35px 0 14px}.info-grid p{max-width:430px;color:var(--muted);line-height:1.5;margin:0}.info-grid article:nth-child(2) p{color:#fff}.info-cta{padding:85px clamp(20px,8vw,140px);background:#0d0f10;border-top:1px solid var(--line)}.info-cta h2{margin:25px 0 35px}.info-cta div{display:flex;gap:10px}.info-cta a{padding:16px 20px;background:var(--red);font:11px var(--mono);text-transform:uppercase}.info-cta a+ a{background:transparent;border:1px solid var(--line)}.info-page footer{display:flex;justify-content:space-between;padding:24px clamp(20px,8vw,140px);font:10px var(--mono);color:var(--muted);border-top:1px solid var(--line)}.info-page footer a{color:var(--ink)}@media(max-width:700px){.info-grid{grid-template-columns:1fr}.info-hero h1,.info-cta h2{font-size:59px}.info-cta div{flex-wrap:wrap}.info-page footer{flex-direction:column;gap:14px}}
</style>
