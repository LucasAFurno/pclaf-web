---
const pageTitle = 'seviyummy — dibujos kawaii';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Galería de ilustraciones kawaii, anime y spooky de seviyummy." />
    <title>{pageTitle}</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='28' fill='%23c7ff48'/%3E%3Cpath d='M24 55c2-25 47-45 58-9 7 22-14 36-31 35-18-1-29-9-27-26Z' fill='%23191a24'/%3E%3Ccircle cx='45' cy='54' r='4' fill='%23ff6b8b'/%3E%3Ccircle cx='64' cy='48' r='4' fill='%23ff6b8b'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root{--ink:#191a24;--paper:#f5f2ea;--acid:#c7ff48;--coral:#ff6b8b;--lav:#d9ccff;--line:#292a36;--muted:#73727d}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Outfit,system-ui,sans-serif}button,a{font:inherit}.shell{max-width:1240px;margin:auto;padding:0 28px}.topbar{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #d8d4ca}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit;font-weight:800;letter-spacing:-.04em;font-size:20px}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:var(--acid);font-size:19px;transform:rotate(-8deg)}.nav{display:flex;align-items:center;gap:24px;font-size:14px}.nav a{text-decoration:none;color:inherit}.nav .studio{padding:11px 15px;border:1px solid var(--line);border-radius:99px;background:var(--ink);color:var(--paper)}.hero{padding:86px 0 72px;display:grid;grid-template-columns:1.1fr .9fr;gap:52px;align-items:end}.kicker,.mono{font-family:'DM Mono',monospace;text-transform:uppercase;letter-spacing:.1em;font-size:12px}.kicker{display:inline-flex;align-items:center;gap:9px;color:var(--muted)}.kicker:before{content:'';width:8px;height:8px;background:var(--coral);border-radius:50%}.hero h1{font-size:clamp(64px,9vw,122px);line-height:.84;letter-spacing:-.09em;margin:22px 0 26px;max-width:720px}.hero h1 em{font-style:normal;color:var(--coral)}.hero-copy{max-width:360px;color:#595863;font-size:17px;line-height:1.5;margin:0 0 16px}.hero-sticker{height:280px;position:relative;background:var(--acid);border:1px solid var(--line);border-radius:26px;overflow:hidden;transform:rotate(3deg)}.hero-sticker:before{content:'✦';position:absolute;font-size:180px;line-height:1;right:28px;top:-16px;color:var(--coral);opacity:.9}.hero-sticker:after{content:'SEVIYUMMY';white-space:pre;position:absolute;left:22px;bottom:22px;font-family:'DM Mono',monospace;font-size:12px;line-height:1.5}.moon{position:absolute;width:145px;height:145px;background:var(--paper);border:1px solid var(--line);border-radius:50%;left:76px;top:52px}.moon:after{content:'♡';position:absolute;font-size:55px;left:40px;top:34px;color:var(--coral);transform:rotate(-15deg)}.orbit{position:absolute;width:235px;height:72px;border:1px solid var(--line);border-radius:50%;left:31px;top:91px;transform:rotate(-18deg)}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.section-head h2{margin:0;font-size:32px;letter-spacing:-.06em}.count{color:var(--muted);font-size:14px}.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}.filter{border:1px solid #cbc7bd;background:transparent;border-radius:99px;padding:10px 15px;color:var(--ink);cursor:pointer;transition:.2s}.filter:hover,.filter.active{background:var(--ink);border-color:var(--ink);color:var(--paper)}.gallery{display:grid;grid-template-columns:repeat(12,1fr);gap:16px;padding-bottom:92px}.card{grid-column:span 4;min-height:345px;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#fff;position:relative;transition:transform .25s,box-shadow .25s}.card:hover{transform:translateY(-7px) rotate(-.4deg);box-shadow:7px 8px 0 var(--coral)}.card:nth-child(2),.card:nth-child(5){grid-column:span 5}.card:nth-child(3),.card:nth-child(6){grid-column:span 3}.art{height:245px;display:grid;place-items:center;position:relative;overflow:hidden}.art:before{content:'';position:absolute;width:180px;height:180px;border-radius:50%;border:1px solid rgba(25,26,36,.25)}.art span{position:relative;font-size:96px;filter:drop-shadow(5px 5px 0 rgba(25,26,36,.12));transition:transform .3s}.card:hover .art span{transform:scale(1.12) rotate(6deg)}.art.a{background:var(--lav)}.art.b{background:var(--coral)}.art.c{background:#9fe9df}.art.d{background:#ffcf71}.art.e{background:#b6e0ff}.art.f{background:#f2a8d8}.card-info{padding:14px 16px 16px;background:#fff}.card-title{font-weight:700;font-size:18px;letter-spacing:-.03em}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.tag{font-family:'DM Mono',monospace;font-size:10px;text-transform:uppercase;padding:5px 7px;border-radius:4px;background:#f0eee8;color:#5e5b61}.empty{grid-column:1/-1;text-align:center;border:1px dashed #9e9aa0;padding:60px;color:var(--muted);border-radius:18px}.footer{border-top:1px solid #d8d4ca;padding:24px 0 50px;display:flex;justify-content:space-between;color:var(--muted);font-size:13px}@media(max-width:800px){.shell{padding:0 18px}.nav a:not(.studio){display:none}.hero{padding:56px 0 54px;display:block}.hero h1{font-size:clamp(64px,19vw,100px)}.hero-sticker{margin:50px 10px 0;height:225px}.card,.card:nth-child(2),.card:nth-child(3),.card:nth-child(5),.card:nth-child(6){grid-column:span 6}.art{height:190px}.card{min-height:285px}.art span{font-size:70px}.footer{display:block}.footer span{display:block;margin-top:8px}}@media(max-width:480px){.card,.card:nth-child(2),.card:nth-child(3),.card:nth-child(5),.card:nth-child(6){grid-column:span 12}.hero h1{font-size:76px}}
      @media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
    </style>
    <style is:global>
      .cta-band{margin-top:112px!important;margin-bottom:100px!important}.section-gap{display:none}.contact{padding-top:0}.sales-grid{gap:18px}.sales-card{min-height:210px}.contact-right{gap:18px}@media(max-width:800px){.cta-band{margin-top:78px!important;margin-bottom:72px!important}.sales{padding-bottom:82px}}
    </style>
    <style is:global>
      .sales{padding:0 0 104px}.sales-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-top:25px}.sales-card{border:1px solid var(--line);border-radius:16px;padding:22px;background:#fff;min-height:190px}.sales-card:nth-child(2){background:var(--acid)}.sales-card:nth-child(3){background:var(--lav)}.sales-num{font-family:'DM Mono',monospace;font-size:12px}.sales-card h3{font-size:24px;letter-spacing:-.05em;margin:28px 0 8px}.sales-card p{color:#5d5b64;line-height:1.45;margin:0;font-size:15px}.cta-band{background:var(--ink);color:var(--paper);border-radius:22px;padding:34px;display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:100px}.cta-band h2{font-size:clamp(32px,5vw,62px);line-height:.9;letter-spacing:-.08em;margin:0;max-width:580px}.cta-button{display:inline-flex;align-items:center;gap:10px;white-space:nowrap;background:var(--coral);color:var(--ink);text-decoration:none;font-weight:800;padding:15px 18px;border-radius:99px}.contact{padding:0 0 86px;display:grid;grid-template-columns:.8fr 1.2fr;gap:40px}.contact h2{font-size:clamp(38px,6vw,70px);line-height:.88;letter-spacing:-.08em;margin:18px 0}.contact-copy{color:#66646d;line-height:1.5;max-width:330px}.contact-list{display:grid;gap:10px;margin-top:26px}.contact-link{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #d2cec4;padding:13px 0;color:inherit;text-decoration:none;font-weight:600}.contact-link span{color:var(--muted);font-family:'DM Mono',monospace;font-size:11px}.contact-right{display:grid;grid-template-columns:1fr 1fr;gap:14px}.map-card{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:#e2ddd1;min-height:295px;position:relative}.map-art{height:100%;min-height:295px;background:#ded9cd;position:relative;overflow:hidden}.map-art:before,.map-art:after{content:'';position:absolute;border:2px solid rgba(25,26,36,.2);border-radius:50%;transform:rotate(25deg)}.map-art:before{width:230px;height:100px;left:-30px;top:90px}.map-art:after{width:270px;height:130px;right:-100px;top:20px}.road{position:absolute;height:2px;background:rgba(25,26,36,.22);transform-origin:left center}.road.one{width:330px;left:18px;top:120px;transform:rotate(20deg)}.road.two{width:280px;left:95px;top:210px;transform:rotate(-42deg)}.road.three{width:250px;left:145px;top:66px;transform:rotate(78deg)}.pin{position:absolute;left:49%;top:45%;width:26px;height:26px;background:var(--coral);border:2px solid var(--ink);border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:4px 4px 0 var(--ink)}.pin:after{content:'';position:absolute;width:8px;height:8px;border-radius:50%;background:var(--ink);left:7px;top:7px}.map-caption{position:absolute;left:18px;bottom:17px;font-family:'DM Mono',monospace;font-size:11px}.map-label{position:absolute;z-index:1;left:14px;top:14px;background:var(--acid);padding:9px 11px;border:1px solid var(--line);font-family:'DM Mono',monospace;font-size:11px;border-radius:7px}.brief-card{background:var(--coral);border:1px solid var(--line);border-radius:16px;padding:20px;min-height:295px;display:flex;flex-direction:column;justify-content:space-between}.brief-card h3{font-size:28px;line-height:.95;letter-spacing:-.06em;margin:0}.brief-card p{font-size:14px;line-height:1.45;color:#53313a}.brief-card a{color:var(--ink);font-weight:800}.editable{font-size:11px;color:var(--muted);margin-top:12px}@media(max-width:800px){.sales-grid{grid-template-columns:1fr}.cta-band{display:block;padding:26px;margin-bottom:72px}.cta-button{margin-top:25px}.contact{display:block}.contact-right{margin-top:35px;grid-template-columns:1fr}.map-card,.map-art{min-height:250px}}
    </style>
    <style is:global>
      .pclaf-footer{width:100%;margin-top:0;background:#080808;color:#888;border:0;padding:26px clamp(4px,7vw,110px);font-size:.74rem;font-family:Outfit,Arial,sans-serif}.pclaf-footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;max-width:1240px;margin:0 auto}.pclaf-footer-brand{display:flex;align-items:center;flex-wrap:wrap;gap:13px}.pclaf-footer a{color:#ddd}.pclaf-credit{display:inline-flex;align-items:center;gap:7px;color:#a7a7a3!important;font-family:'DM Mono',monospace;font-size:.62rem;text-decoration:none!important;transition:color .18s}.pclaf-credit:hover{color:#fff!important}.pclaf-credit img{width:28px;height:28px;object-fit:contain;border-radius:3px}.pclaf-credit b{color:#fff;font-family:Outfit,Arial,sans-serif;font-size:.72rem;letter-spacing:-.02em}.pclaf-footer-links{display:flex;align-items:center;flex-wrap:wrap;gap:8px}.pclaf-footer-links i{font-style:normal;color:#777}.pclaf-footer-links a{text-decoration:underline;text-underline-offset:2px}.pclaf-footer-links a:hover{color:#fff}@media(max-width:740px){.pclaf-footer{padding:28px 16px 32px}.pclaf-footer-inner{flex-direction:column;align-items:center;gap:20px;text-align:center}.pclaf-footer-brand{width:100%;justify-content:center;align-items:center;flex-direction:column;gap:0}.pclaf-credit{width:auto;justify-content:center;white-space:nowrap}.pclaf-footer-links{width:100%;justify-content:center;gap:9px;line-height:1.5}}
    </style>
    <style is:global>
      .art:before{display:none}.section-tools{display:flex;align-items:flex-end;gap:16px}.search-box{position:relative}.search-box label{display:block;font:10px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:6px}.search-box input{width:235px;border:1px solid #cbc7bd;border-radius:99px;background:transparent;color:var(--ink);padding:10px 14px;font:14px Outfit,system-ui,sans-serif;outline:0}.search-box input::placeholder{color:#8b8990}.search-box input:focus{border-color:var(--ink);box-shadow:0 0 0 3px rgba(25,26,36,.08)}.card{cursor:pointer}.card.is-selected{outline:3px solid var(--coral);outline-offset:3px;transform:translateY(-3px) rotate(-.2deg);box-shadow:0 0 0 1px var(--coral)}.card.is-selected:after{display:none}.selection-bar{position:fixed;z-index:10;left:50%;top:94px;transform:translateX(-50%);width:min(720px,calc(100vw - 36px));display:flex;align-items:center;gap:18px;padding:13px 16px;border:1px solid var(--ink);border-radius:16px;background:var(--ink);color:var(--paper);box-shadow:8px 8px 0 var(--coral)}.selection-count{display:flex;align-items:center;gap:9px;white-space:nowrap;font-weight:800}.selection-count b{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:var(--acid);color:var(--ink)}.selection-names{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#d7d4db;font-size:13px}.selection-copy,.selection-clear{border:1px solid #777681;border-radius:99px;background:transparent;color:var(--paper);padding:8px 11px;cursor:pointer;white-space:nowrap;font-size:12px}.selection-copy{border-color:var(--coral)}.selection-copy:hover,.selection-copy.is-copied{background:var(--coral);color:var(--ink);border-color:var(--coral)}.selection-clear{margin-left:auto}.selection-clear:hover{background:var(--acid);color:var(--ink);border-color:var(--acid)}@media(max-width:850px){.section-tools{width:100%;align-items:stretch;flex-direction:column;gap:10px}.search-box{width:100%}.search-box input{display:block;width:100%}.search-box label{margin-bottom:5px}.section-head{align-items:stretch;flex-direction:column}.selection-bar{top:82px;gap:8px;padding:11px 12px}.selection-names{font-size:11px}.selection-copy,.selection-clear{padding:7px 9px}}
    </style>
    <style is:global>
      [hidden]{display:none!important}
      .gallery{display:grid!important;grid-template-columns:repeat(5,minmax(0,1fr))!important;gap:16px}.gallery .card{grid-column:auto!important;min-height:0;aspect-ratio:1/1}.gallery .art{height:100%!important;aspect-ratio:auto;background-position:center center!important;background-size:cover!important;user-select:none;-webkit-user-drag:none}.gallery .art::after{content:'SEVIYUMMY';position:absolute;z-index:3;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-12deg);padding:5px 8px;border:1px solid rgba(255,255,255,.45);border-radius:6px;color:rgba(255,255,255,.48);font:800 clamp(12px,1.55vw,20px)/1 Outfit,system-ui,sans-serif;letter-spacing:.1em;text-shadow:1px 1px 3px rgba(25,26,36,.45);white-space:nowrap;pointer-events:none;user-select:none}.gallery .card-info{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;justify-content:space-between;padding:14px 14px 13px;background:linear-gradient(to bottom,rgba(25,26,36,.58),transparent 30%,transparent 62%,rgba(25,26,36,.68));color:var(--paper);pointer-events:none}.gallery .card-title{color:#fff;text-shadow:1px 1px 0 rgba(25,26,36,.35)}.gallery .tags{margin-top:0}.gallery .tag{background:rgba(245,242,234,.92);color:var(--ink)}
      .gallery-page{padding-top:56px}.gallery-instruction{max-width:620px;margin:14px 0 0;color:var(--muted);font-size:15px;line-height:1.45}.filters{width:100%;align-items:center}.search-box input{background:rgba(199,255,72,.3)!important;border-color:var(--ink)!important;box-shadow:4px 4px 0 var(--ink)!important;font-weight:600}.search-box input:focus{background:var(--acid)!important;border-color:var(--ink)!important;box-shadow:4px 4px 0 var(--coral)!important}
      @media(max-width:1100px){.gallery{grid-template-columns:repeat(5,minmax(0,1fr))!important}}
      @media(max-width:850px){.shell{padding-left:1px;padding-right:1px}.gallery{grid-template-columns:repeat(5,minmax(0,1fr))!important;gap:1px}.gallery .card{border-radius:6px}.gallery .card-title{font-size:11px}}
      @media(max-width:620px){.shell{padding-left:2px;padding-right:2px}.gallery{grid-template-columns:repeat(5,minmax(0,1fr))!important;gap:2px}.gallery .card{border-radius:7px}.gallery .card-info{padding:2px}.gallery .card-title{font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.gallery .tag{font-size:4px;padding:1px 2px}.gallery .art::after{font-size:8px;padding:2px 3px}}
      @media(max-width:420px){.shell{padding-left:1px;padding-right:1px}.gallery{grid-template-columns:repeat(5,minmax(0,1fr))!important;gap:1px}.gallery .card{border-radius:5px}.gallery .card-info{padding:2px}.gallery .card-title{font-size:7px}.gallery .tag{font-size:3px;padding:1px}.gallery .art::after{font-size:6px;padding:2px}}
    </style>
  </head>
  <body>
    <main>
      <section class="shell gallery-page" id="galeria"><div class="section-head"><div><span class="mono">collection</span><h2>seviyummy gallery</h2><p class="gallery-instruction">Select the images you need, then click <strong>Copy names</strong> to share the exact list and quantity.</p></div><div class="section-tools"><div class="search-box"><label for="gallery-search">Search the gallery</label><input id="gallery-search" type="search" placeholder="Name or tag…" autocomplete="off" /></div><span class="count" id="count">06 artworks</span></div></div><div class="filters" id="filters"><button class="filter active" data-filter="all">All</button><button class="filter" data-filter="anime">Anime</button><button class="filter" data-filter="pokemon">Pokémon</button><button class="filter" data-filter="halloween">Halloween</button><button class="filter" data-filter="cute">Cute</button></div><div class="gallery" id="gallery"></div></section>
    </main>
    <footer class="pclaf-footer"><div class="pclaf-footer-inner"><div class="pclaf-footer-brand"><a class="pclaf-credit" href="https://www.pclaf.com.ar/" target="_blank" rel="noreferrer"><span>Site developed by</span><img src="/assets/pclaf-logo.png" alt="PCLAF" /><b>PCLAF</b></a></div><span class="pclaf-footer-links"><a href="https://operando.app/privacidad/" target="_blank" rel="noreferrer">Privacy</a><i aria-hidden="true">·</i><a href="https://operando.app/terminos/" target="_blank" rel="noreferrer">Terms</a><i aria-hidden="true">·</i><a href="https://wa.me/5491135708345?text=Hola%20operando.app%2C%20quiero%20informacion%20de%20operando.app." target="_blank" rel="noreferrer">WhatsApp</a></span></div></footer>
    <div id="selection-bar" class="selection-bar" hidden><div class="selection-count"><b id="selection-count">0</b><span>selected</span></div><div id="selection-names" class="selection-names"></div><button id="selection-copy" class="selection-copy" type="button">Copy names</button><button id="selection-clear" class="selection-clear" type="button">Clear</button></div>
    <script>
      const demoGroups = [{label:'Pokemon',slug:'pokemon',emoji:'⚡',colors:['#f7d64a','#6a45a8'],tags:['pokemon','anime','demo']},{label:'Digimon',slug:'digimon',emoji:'🐾',colors:['#f26b4f','#244f91'],tags:['digimon','anime','demo']},{label:'Chainsaw Man',slug:'chainsaw-man',emoji:'⛓',colors:['#ed633f','#1d202b'],tags:['chainsaw-man','anime','action','demo']},{label:'Cars',slug:'cars',emoji:'🏎',colors:['#56c8d8','#28334a'],tags:['cars','vehicles','demo']}];
      function makeDemoImage(group,index){return `https://picsum.photos/seed/seviyummy-${group.slug}-${index+1}/800/800`}
      const demoArtwork=demoGroups.flatMap(group=>Array.from({length:40},(_,index)=>({title:`${group.label} ${String(index+1).padStart(2,'0')}`,image:makeDemoImage(group,index),tags:group.tags,demo:true,demoVersion:'random-v1',demoGroup:group.slug})));
      const gallery = document.querySelector('#gallery'); const count = document.querySelector('#count'); const search = document.querySelector('#gallery-search'); const filterRoot=document.querySelector('#filters'); const selectionBar=document.querySelector('#selection-bar'); const selectionCount=document.querySelector('#selection-count'); const selectionNames=document.querySelector('#selection-names'); const selectionCopy=document.querySelector('#selection-copy'); const selectionClear=document.querySelector('#selection-clear');
      let customs = JSON.parse(localStorage.getItem('mochi-moon-art') || '[]'); let active='all'; let query=''; const selected=new Map();
      function selectionKey(x){return `${x.title}|${x.image||x.emoji||''}`}
      function updateSelection(){selectionBar.hidden=!selected.size;selectionCount.textContent=selected.size;selectionNames.textContent=[...selected.values()].join(' · ')}
      function render(){const storedDemo=customs.filter(x=>x.demo&&x.demoVersion==='random-v1');const all=[...customs.filter(x=>!x.demo),...(storedDemo.length?storedDemo:demoArtwork)];renderFilters(all);const shown=all.filter(x=>{const tags=[...(x.tags||[]),...(x.hiddenTags||[])];const matchesMood=active==='all'||tags.includes(active);const haystack=[x.title,...tags].join(' ').toLowerCase();return matchesMood&&(!query||haystack.includes(query))});count.textContent=`${shown.length.toString().padStart(2,'0')} artworks`;gallery.innerHTML=shown.length?shown.map(x=>{const key=encodeURIComponent(selectionKey(x));return `<article class="card${selected.has(selectionKey(x))?' is-selected':''}" data-selection-key="${key}" tabindex="0" role="button" aria-pressed="${selected.has(selectionKey(x))}"><div class="art ${x.art||'a'}" ${x.image?`style="background-image:url('${x.image}');background-size:cover;background-position:center"`:''}>${x.image?'':`<span aria-hidden="true">${x.emoji||'✦'}</span>`}</div><div class="card-info"><div class="card-title">${x.title}</div><div class="tags">${(x.tags||[]).map(t=>`<span class="tag">#${t}</span>`).join('')}</div></div></article>`}).join(''):`<div class="empty">No artworks found with that name or tag. Try another search ✦</div>`;updateSelection()}
      function filterLabel(tag){const labels={pokemon:'Pokémon','chainsaw-man':'Chainsaw Man',cars:'Cars',vehicles:'Vehicles'};return labels[tag]||tag.charAt(0).toUpperCase()+tag.slice(1)}
      function renderFilters(all){const publicTags=[...new Set(all.flatMap(x=>x.tags||[]))];filterRoot.innerHTML=[['all','All'],...publicTags.map(tag=>[tag,filterLabel(tag)])].map(([value,label])=>`<button class="filter${active===value?' active':''}" data-filter="${value}">${label}</button>`).join('');filterRoot.querySelectorAll('.filter').forEach(btn=>btn.addEventListener('click',()=>{active=btn.dataset.filter;render()}))}
      function toggleCard(card){const key=decodeURIComponent(card.dataset.selectionKey);const title=card.querySelector('.card-title').textContent;if(selected.has(key))selected.delete(key);else selected.set(key,title);render()}
      gallery.addEventListener('click',e=>{const card=e.target.closest('.card');if(card)toggleCard(card)});gallery.addEventListener('contextmenu',e=>e.preventDefault());gallery.addEventListener('dragstart',e=>e.preventDefault());gallery.addEventListener('keydown',e=>{const card=e.target.closest('.card');if(card&&(e.key==='Enter'||e.key===' ')){e.preventDefault();toggleCard(card)}});selectionCopy.addEventListener('click',async()=>{if(!selected.size)return;try{const names=[...selected.values()];await navigator.clipboard.writeText(`${names.length} images:\n${names.join('\n')}`);selectionCopy.textContent='Copied! ✓';selectionCopy.classList.add('is-copied');setTimeout(()=>{selectionCopy.textContent='Copy names';selectionCopy.classList.remove('is-copied')},1800)}catch{selectionCopy.textContent='Copy failed';setTimeout(()=>selectionCopy.textContent='Copy names',1800)}});selectionClear.addEventListener('click',()=>{selected.clear();render()});search.addEventListener('input',()=>{query=search.value.trim().toLowerCase();render()});render();
    </script>
  </body>
</html>
