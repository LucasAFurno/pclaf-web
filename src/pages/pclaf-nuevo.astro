<script>
  document.querySelectorAll('video.intro-video, video.services-video').forEach((video) => {
    if (video instanceof HTMLVideoElement) {
      video.muted = true;
      video.play().catch(() => {});
      video.addEventListener('loadeddata', () => video.play().catch(() => {}), { once: true });
    }
  });

  const reviewTrack = document.querySelector('.review-track');
  if (reviewTrack instanceof HTMLElement) {
    [...reviewTrack.querySelectorAll('.review-card')].forEach((card) => {
      const clone = card.cloneNode(true);
      if (clone instanceof HTMLElement) clone.setAttribute('aria-hidden', 'true');
      reviewTrack.appendChild(clone);
    });
  }

  const statsEndpoint = 'https://bcmfzgjpqfjnudhgraan.supabase.co/functions/v1/pclaf-portal';
  const statsKey = 'sb_publishable_I1oJLpCSeneeIw2SghABAw_GXrdLLWs';
  const statNodes = Object.fromEntries([...document.querySelectorAll('[data-stat]')].map((node) => [node.dataset.stat, node]));
  const formatStat = (value) => new Intl.NumberFormat('es-AR').format(value);
  const updateLiveStats = async () => {
    try {
      const response = await fetch(statsEndpoint, { method: 'POST', headers: { apikey: statsKey, Authorization: `Bearer ${statsKey}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'stats' }) });
      if (!response.ok) throw new Error(`Stats ${response.status}`);
      const payload = await response.json();
      const stats = payload?.data;
      if (!stats) throw new Error('Stats sin datos');
      if (statNodes.clients) statNodes.clients.textContent = formatStat(stats.clients);
      if (statNodes.repairs) statNodes.repairs.textContent = formatStat(stats.repairs * 3);
      if (statNodes.gamers) statNodes.gamers.textContent = formatStat(stats.gamers * 3);
      if (statNodes.equipment) statNodes.equipment.textContent = formatStat(stats.equipment);
    } catch (error) {
      console.warn('No se pudieron actualizar las métricas públicas de PCLAF.', error);
    }
  };
  updateLiveStats();
  window.setInterval(updateLiveStats, 30 * 24 * 60 * 60 * 1000);

</script>

