---
import SiteLayout from '../layouts/SiteLayout.astro';
import PclafHeader from '../components/PclafHeader.astro';
---
<SiteLayout title="Ver reparación | PCLAF" description="Consultá el estado de tu reparación en PCLAF.">
  <div class="history-page"><PclafHeader /><main>
    <section class="history-hero"><p class="eyebrow">PCLAF / SEGUIMIENTO</p><h1>Tu reparación,<br /><em>en movimiento.</em></h1><p class="lead">Ingresá el código que te entregamos al recibir tu equipo y consultá las novedades de tu arreglo.</p></section>
    <section class="lookup-wrap"><form id="history-form"><label for="code">Código de seguimiento</label><div class="lookup-row"><input id="code" name="codigo" required placeholder="Ej. PCLAF-2026-001" autocomplete="off" /><button>Ver estado <span>↗</span></button></div><p id="history-status" role="status">Tu código nos permite mostrarte solo la información de tu reparación.</p></form><div id="history-result" aria-live="polite"></div></section>
    <section class="history-help"><p class="eyebrow">¿NO ENCONTRÁS EL CÓDIGO?</p><h2>Estamos para<br /><em>ayudarte.</em></h2><a href="https://wa.me/5491135708345?text=Hola%2C%20necesito%20consultar%20el%20estado%20de%20mi%20reparaci%C3%B3n" target="_blank" rel="noopener noreferrer">Escribir por WhatsApp ↗</a></section>
  </main><footer><span>PCLAF / SERVICIO TÉCNICO</span><span>Buenos Aires, Argentina</span><a href="/pclaf-nuevo.html">Volver al inicio ↗</a></footer></div>
</SiteLayout>
<script>
  const endpoint='https://bcmfzgjpqfjnudhgraan.supabase.co/functions/v1/pclaf-portal',apiKey='sb_publishable_I1oJLpCSeneeIw2SghABAw_GXrdLLWs',form=document.querySelector('#history-form'),status=document.querySelector('#history-status'),result=document.querySelector('#history-result');
  async function lookup(codigo){const response=await fetch(endpoint,{method:'POST',headers:{apikey:apiKey,Authorization:`Bearer ${apiKey}`,'Content-Type':'application/json'},body:JSON.stringify({action:'history',codigo})});if(!response.ok)throw new Error();return response.json()}
  const esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
  form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('button');button.disabled=true;button.textContent='Buscando...';status.textContent='Consultando tu reparación...';result.innerHTML='';try{const response=await lookup(new FormData(form).get('codigo')),data=response.data;if(!data){status.textContent='No encontramos una reparación con ese código.';result.innerHTML='<div class="empty">Revisá el código e intentá nuevamente. Si seguís con dudas, escribinos por WhatsApp.</div>';return}status.textContent=`Información actualizada para ${data.client?.nombre||'tu equipo'}.`;result.innerHTML=renderHistory(data)}catch{status.textContent='No pudimos conectar con el portal. Intentá nuevamente en unos segundos.'}finally{button.disabled=false;button.textContent='Ver estado ↗'}});
  function renderHistory(data){const machines=(data.machines||[]).map(machine=>`<article class="machine"><div class="machine-head"><span class="machine-icon">${esc(machine.icono||'▣')}</span><div><h3>${esc(machine.nombre||'Equipo')}</h3><p>${esc(machine.modelo||'Equipo registrado')}</p></div></div>${(machine.repairs||[]).map(repair=>`<div class="repair"><div class="repair-top"><span>${esc(repair.numero||'Reparación')}</span><b>${esc(repair.estado||'En revisión')}</b></div><h4>${esc(repair.problema||'Servicio técnico')}</h4><p class="repair-date">Recibido ${esc(repair.fecha_entrega||repair.created_at||'—')}</p>${repair.steps?.length?`<div class="timeline">${repair.steps.map(step=>`<div class="timeline-step"><i></i><span>${esc(step.titulo||step.nombre||step.descripcion||step)}</span></div>`).join('')}</div>`:'<p class="muted">Estamos actualizando las novedades de tu equipo.</p>'}</div>`).join('')}</article>`).join('');return `<div class="result-head"><p class="eyebrow">HISTORIAL ENCONTRADO</p><h2>${esc(data.client?.nombre||'Tu cuenta')}</h2><p>Estos son los equipos asociados a tu código.</p></div><div class="machines">${machines||'<div class="empty">Todavía no hay reparaciones cargadas.</div>'}</div>`}
</script>
<style>
  :global(:root){--bg:#151719;--ink:#f2eee7;--red:#e12b24;--green:#53d88e;--muted:#aaa39b;--line:#3d4143;--mono:'DM Mono',monospace;--sans:'Space Grotesk',sans-serif}:global(*){box-sizing:border-box}:global(body){margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans)}:global(a){color:inherit;text-decoration:none}.history-page{min-height:100vh;background:radial-gradient(circle at 80% 20%,rgba(83,216,142,.08),transparent 28%),var(--bg)}.history-hero{padding:clamp(80px,12vw,155px) clamp(20px,8vw,140px) 80px;border-bottom:1px solid var(--line)}.eyebrow{font:10px var(--mono);letter-spacing:.13em;color:var(--red);text-transform:uppercase}.history-hero h1,.history-help h2,.result-head h2{font-size:clamp(63px,8vw,115px);line-height:.84;letter-spacing:-.1em;font-weight:500;margin:34px 0 0}.history-hero h1 em,.history-help h2 em{color:var(--green);font-style:italic}.lead{max-width:560px;color:#c7c4bd;font-size:19px;line-height:1.5;margin:34px 0 0}.lookup-wrap{max-width:1120px;margin:auto;padding:65px 24px 120px}.lookup-wrap label{display:block;color:var(--muted);font:10px var(--mono);letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px}.lookup-row{display:flex;gap:10px}.lookup-row input{flex:1;min-width:0;border:1px solid var(--line);background:#0d0f10;color:var(--ink);padding:18px;font:18px var(--mono);outline:none}.lookup-row input:focus{border-color:var(--green)}button,.history-help a{border:0;background:var(--green);color:#07120d;padding:18px 24px;font:11px var(--mono);letter-spacing:.08em;text-transform:uppercase;cursor:pointer}.lookup-wrap>form>p{color:var(--muted);font:11px var(--mono);margin:15px 0 55px}.result-head{border-top:1px solid var(--line);padding-top:38px}.result-head h2{font-size:55px;margin:18px 0 10px}.result-head>p:last-child{color:var(--muted);margin:0}.machines{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:28px}.machine{background:#1b1e20;border:1px solid var(--line)}.machine-head{display:flex;gap:16px;padding:22px;border-bottom:1px solid var(--line);align-items:center}.machine-icon{font-size:28px;color:var(--green)}.machine-head h3{font-size:24px;font-weight:500;margin:0}.machine-head p,.repair-date,.muted{font:11px var(--mono);color:var(--muted);margin:6px 0 0}.repair{padding:22px}.repair-top{display:flex;justify-content:space-between;font:10px var(--mono);color:var(--muted);text-transform:uppercase}.repair-top b{color:var(--green);font-weight:400}.repair h4{font-size:24px;font-weight:500;margin:20px 0 0}.timeline{border-left:1px solid var(--green);margin:28px 0 0 4px;padding-left:18px;display:grid;gap:15px}.timeline-step{display:flex;gap:9px;align-items:center;font-size:13px}.timeline-step i{width:7px;height:7px;background:var(--green);border-radius:50%;margin-left:-22px}.empty{border:1px solid var(--line);padding:28px;color:var(--muted);font:12px var(--mono)}.history-help{padding:90px clamp(20px,8vw,140px);background:#0d0f10;border-top:1px solid var(--line)}.history-help h2{margin:24px 0 34px;font-size:clamp(54px,7vw,92px)}.history-help a{display:inline-block}.history-page footer{display:flex;justify-content:space-between;padding:25px clamp(20px,8vw,140px);border-top:1px solid var(--line);font:10px var(--mono);color:var(--muted)}.history-page footer a{color:var(--ink)}
  @media(max-width:700px){.lookup-row{flex-direction:column}.machines{grid-template-columns:1fr}.history-hero h1{font-size:58px}.history-page footer{flex-direction:column;gap:14px}}
</style>
