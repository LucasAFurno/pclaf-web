---
import SectionedPageLayout from '../../layouts/SectionedPageLayout.astro';
import { sectionedPageParts } from '../../lib/sectioned-page';
import { consoles } from '../../data/consoles';

export function getStaticPaths() {
  return consoles.map((item) => ({ params: { slug: item.slug }, props: { console: item } }));
}

const { console } = Astro.props;
const parts = sectionedPageParts('service-tecnico-pc-flores-floresta.html');
const esc = (value: string) => value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const internal = (html: string) => html.replace(/(href|src)="assets\//g, '$1="/assets/').replace(/href="(?!https?:|\/|#)([^"]+\.html(?:#[^"]*)?)"/g, 'href="/$1"');
const beforeSections = internal(parts.beforeSections)
  .replace(/<title>[^<]*<\/title>/, `<title>${esc(console.seoTitle)}<\/title>`)
  .replace(/<meta name="description" content="[^"]*">/, `<meta name="description" content="${esc(console.description)}">`)
  .replace(/<link rel="canonical" href="[^"]*">/, `<link rel="canonical" href="https://www.pclaf.com.ar/consolas/${console.slug}.html">`);
const afterSections = internal(parts.afterSections);
const sections = [
  `<section class="hero"><video class="hero-bg-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="${esc(console.video)}" type="video/mp4"></video><div class="hero-copy"><div class="eyebrow">Service preventivo de consola · ${esc(console.shortName)}</div><h1>Service de <span>${esc(console.name)}</span> en Floresta</h1><p>PCLAF realiza limpieza y mantenimiento térmico para ayudar a bajar la temperatura, reducir el ruido del cooler y prevenir desgaste por exceso de calor. Solo hacemos service preventivo: no reparamos placas ni joysticks.</p><div class="hero-utility"><div class="hero-actions"><span class="hero-actions-kicker">¿Querés cuidar tu consola?</span><a class="primary hero-track-repair" href="/turnos.html?servicio=${console.slug}">Pedir turno de service →</a><div class="hero-actions-new"><span>También podés consultar el precio antes de traerla.</span><div><a href="/precios.html#consolas">Ver precios</a><a href="/turnos.html?servicio=${console.slug}">Elegir horario</a></div></div></div><div class="appointment-notice"><div class="appointment-notice-label">Importante</div>Atendemos únicamente con turno previo. Es un laboratorio cerrado, no un local a la calle.</div></div></div></section>`,
  `<section class="service-overview"><div class="service-overview-head"><div><div class="eyebrow">${esc(console.shortName)} · Floresta</div><h2>Menos temperatura, <span>más tranquilidad</span></h2></div><p>${esc(console.includes)}. El objetivo es cuidar el sistema térmico para que la consola trabaje más estable.</p></div><div class="service-feature-grid"><article class="service-feature"><div class="service-feature-num">01 · LIMPIEZA</div><div class="service-feature-icon">🎮</div><h3>Interior limpio</h3><p>Retiramos polvo y suciedad acumulada para mejorar la circulación de aire.</p></article><article class="service-feature"><div class="service-feature-num">02 · TÉRMICO</div><div class="service-feature-icon">◉</div><h3>Materiales adecuados</h3><p>${esc(console.includes)} y revisión del sistema de disipación según el modelo.</p></article><article class="service-feature"><div class="service-feature-num">03 · CLARO</div><div class="service-feature-icon">✓</div><h3>Solo service preventivo</h3><p>No hacemos reparación de placas, cambios de piezas ni service de joysticks.</p></article></div><div class="process-wrap"><div class="process-title">Precio del service: <span>${esc(console.price)}</span></div><div class="process-grid"><article class="process-step"><div class="process-step-num">01</div><h3>Reservás un horario</h3><p>Elegís día y hora desde la página de turnos.</p></article><article class="process-step"><div class="process-step-num">02</div><h3>Hacemos el mantenimiento</h3><p>Trabajamos sobre limpieza y temperatura.</p></article><article class="process-step"><div class="process-step-num">03</div><h3>La retirás lista</h3><p>Te avisamos por WhatsApp cuando termina.</p></article></div></div></section>`,
  `<section class="cta"><div class="cta-box"><h2>¿Tu consola calienta o hace mucho ruido?</h2><p>Pedí turno para un service preventivo de ${esc(console.name)}.</p><div class="cta-links"><a href="/turnos.html?servicio=${console.slug}">Pedir turno</a><a href="/precios.html#consolas">Ver precios</a><a href="/index.html">Volver al inicio</a></div></div></section>`
];
---
<SectionedPageLayout beforeSections={beforeSections} sections={sections} afterSections={afterSections} />

