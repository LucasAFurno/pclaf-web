---
import SiteLayout from '../layouts/SiteLayout.astro';
import PclafHeader from '../components/PclafHeader.astro';
---
<SiteLayout title="Servicio técnico de PC y notebook en Flores y Floresta | PCLAF" description="Servicio técnico de PC y notebook en Flores y Floresta con diagnóstico claro, presupuesto previo y seguimiento online.">
  <Fragment slot="head"><link rel="canonical" href="https://www.pclaf.com.ar/service-tecnico-pc-flores-floresta.html" /></Fragment>
  <div class="tech-page"><PclafHeader /><main>
    <section class="tech-hero"><video autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="/assets/pc-motherboard-loop.mp4" type="video/mp4" /></video><div class="shade"></div><div class="hero-inner"><p class="eyebrow">PCLAF / ARREGLO TÉCNICO</p><h1>Tu equipo,<br /><em>listo para usar.</em></h1><p class="lead">Servicio técnico de PC y notebook para Flores, Floresta y zonas cercanas. Diagnóstico claro, presupuesto antes de avanzar y atención por turno.</p><div class="actions"><a class="red-btn" href="/turnos.html">Pedir turno ↗</a><a class="line-btn" href="/historial.html">Ver reparación ↗</a></div></div></section>
    <section class="tech-strip"><div><b>01</b><span>Diagnóstico claro</span></div><div><b>02</b><span>Presupuesto previo</span></div><div><b>03</b><span>Seguimiento online</span></div><div class="green"><b>FLORESTA</b><span>Campana 51 · CABA</span></div></section>
    <section class="tech-services"><div class="heading"><p class="eyebrow">QUÉ PODEMOS RESOLVER</p><h2>Volvé a usar<br /><em>tu equipo.</em></h2><p>Trabajamos sobre problemas concretos, con información clara en cada paso.</p></div><div class="service-grid"><article><small>01 / RENDIMIENTO</small><h3>Optimización y puesta a punto</h3><p>Si está lento, se traba o tarda en arrancar, revisamos qué lo está frenando y lo dejamos funcionando mejor.</p></article><article class="red"><small>02 / MANTENIMIENTO</small><h3>Limpieza y pasta térmica</h3><p>Reducimos temperatura, ruido y desgaste en PC, notebook y equipos gamer.</p></article><article><small>03 / SISTEMA</small><h3>Windows y formateo</h3><p>Instalación, configuración, backups y puesta a punto para volver a trabajar sin vueltas.</p></article><article class="dark"><small>04 / HARDWARE</small><h3>Discos, memoria y componentes</h3><p>Detectamos qué componente falla y te explicamos si conviene reparar, actualizar o reemplazar.</p></article></div></section>
    <section class="process"><div><p class="eyebrow">ASÍ TRABAJAMOS</p><h2>Claro y sin<br /><em>sorpresas.</em></h2></div><div class="steps"><article><b>01</b><h3>Nos contás qué pasa</h3><p>Pedís turno y traés el equipo al taller.</p></article><article><b>02</b><h3>Lo revisamos</h3><p>Buscamos la causa real y armamos un diagnóstico.</p></article><article><b>03</b><h3>Lo retirás listo</h3><p>Te pasamos el valor antes y te avisamos cuando termina.</p></article></div></section>
    <section class="tech-cta"><p class="eyebrow">¿YA DEJASTE TU EQUIPO?</p><h2>Consultá tu<br /><em>reparación.</em></h2><a class="dark-btn" href="/historial.html">Ver estado del arreglo ↗</a></section>
  </main><footer><span>© 2026 PCLAF</span><span>Floresta / Flores / CABA</span><a href="mailto:pclaf@gmail.com">pclaf@gmail.com</a></footer></div>
</SiteLayout>
<style>
  :global(:root){--bg:#151719;--ink:#f2eee7;--red:#e12b24;--green:#53d88e;--muted:#aaa39b;--line:#3d4143;--mono:'DM Mono',monospace;--sans:'Space Grotesk',sans-serif}:global(*){box-sizing:border-box}:global(body){margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans)}:global(a){text-decoration:none;color:inherit}.tech-page{min-height:100vh;background:var(--bg)}.tech-hero{position:relative;min-height:600px;overflow:hidden}.tech-hero video,.tech-hero .shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.tech-hero video{opacity:.48;filter:saturate(.7) contrast(1.15)}.shade{background:linear-gradient(90deg,rgba(10,11,12,.95),rgba(10,11,12,.58) 55%,rgba(10,11,12,.15))}.hero-inner{position:relative;padding:clamp(80px,11vw,150px) clamp(20px,8vw,140px)}.eyebrow{margin:0 0 28px;color:var(--red);font:11px var(--mono);letter-spacing:.13em}.hero-inner h1,.heading h2,.process h2,.tech-cta h2{margin:0;font-size:clamp(58px,8vw,112px);line-height:.84;letter-spacing:-.1em;font-weight:500}.hero-inner h1 em,.heading h2 em,.process h2 em,.tech-cta h2 em{color:var(--red);font-style:italic}.lead{max-width:640px;color:#d1cfca;font-size:20px;line-height:1.45;margin:34px 0 0}.actions{display:flex;gap:12px;margin-top:34px;flex-wrap:wrap}.red-btn,.line-btn,.dark-btn{padding:16px 20px;font:11px var(--mono);letter-spacing:.08em;text-transform:uppercase}.red-btn{background:var(--red);color:#fff}.line-btn{border:1px solid #777;background:rgba(10,11,12,.4)}.tech-strip{display:grid;grid-template-columns:repeat(3,1fr) 1.4fr;padding:0 clamp(20px,8vw,140px);border-bottom:1px solid var(--line)}.tech-strip div{display:flex;flex-direction:column;gap:7px;padding:24px 20px 24px 0;margin-right:20px;border-right:1px solid var(--line)}.tech-strip b{font-size:28px;font-weight:500}.tech-strip span{font:10px var(--mono);color:var(--muted);text-transform:uppercase}.tech-strip .green{border:0}.tech-strip .green b{color:var(--green);font:13px var(--mono);letter-spacing:.08em}.tech-services{padding:clamp(90px,12vw,160px) clamp(20px,8vw,140px)}.heading{display:grid;grid-template-columns:1fr 1.2fr 260px;gap:30px;align-items:end;margin-bottom:60px}.heading h2{font-size:clamp(50px,6vw,84px)}.heading>p:last-child{margin:0;color:var(--muted);line-height:1.5}.service-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}.service-grid article{min-height:220px;padding:28px;background:#1b1e20;border:1px solid var(--line)}.service-grid article.red{background:var(--red);border-color:var(--red)}.service-grid article.dark{background:#08090a}.service-grid small{font:10px var(--mono);color:var(--red);letter-spacing:.1em}.service-grid .red small{color:#2b0806}.service-grid h3{max-width:520px;margin:25px 0 15px;font-size:clamp(28px,3.5vw,48px);line-height:.9;letter-spacing:-.07em;font-weight:500}.service-grid p{max-width:520px;margin:0;color:#b9b9b3;line-height:1.6}.service-grid .red p{color:#fff}.process{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;padding:0 clamp(20px,8vw,140px) 150px}.process h2{font-size:clamp(48px,6vw,80px)}.steps{border-top:1px solid var(--line)}.steps article{display:grid;grid-template-columns:50px 1fr;gap:12px;padding:22px 0;border-bottom:1px solid var(--line)}.steps b{color:var(--red);font:11px var(--mono)}.steps h3{margin:0;font-size:24px;font-weight:500}.steps p{grid-column:2;margin:0;color:var(--muted)}.tech-cta{display:grid;grid-template-columns:1fr 1fr auto;align-items:center;gap:30px;padding:55px clamp(20px,8vw,140px);background:var(--red)}.tech-cta .eyebrow{color:#2b0806;margin:0}.tech-cta h2{font-size:clamp(43px,5vw,70px)}.tech-cta h2 em{color:#2b0806}.dark-btn{background:#2b0806;color:#fff}.tech-page footer{display:flex;justify-content:space-between;gap:20px;padding:24px clamp(20px,8vw,140px);background:#0b0d0e;color:#858b8d;font:10px var(--mono)}.tech-page footer a{color:var(--ink)}
  @media(max-width:800px){.tech-strip{grid-template-columns:repeat(2,1fr)}.tech-strip .green{grid-column:span 2;border-top:1px solid var(--line);padding-top:20px}.heading,.process,.tech-cta{grid-template-columns:1fr}.heading>p:last-child{max-width:320px}.process{gap:50px}.tech-cta .dark-btn{justify-self:start}.tech-page footer{flex-wrap:wrap}.tech-page footer span:nth-child(2){display:none}}@media(max-width:520px){.hero-inner{padding:70px 18px}.hero-inner h1{font-size:61px}.lead{font-size:17px}.tech-services{padding:85px 18px}.process{padding:0 18px 90px}.tech-cta{padding:45px 18px}.tech-page footer{padding:20px 18px}}
</style>
