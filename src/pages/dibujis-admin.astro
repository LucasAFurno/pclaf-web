<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>seviyummy — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" /><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root{--ink:#191a24;--paper:#f5f2ea;--acid:#c7ff48;--coral:#ff6b8b;--line:#292a36;--muted:#73727d}*{box-sizing:border-box}body{margin:0;background:var(--ink);color:var(--paper);font-family:Outfit,system-ui,sans-serif}.shell{max-width:1120px;margin:auto;padding:0 28px}.topbar{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #44434b}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit;font-weight:800;letter-spacing:-.04em;font-size:20px}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:var(--acid);color:var(--ink);font-size:19px;transform:rotate(-8deg)}.back{color:var(--paper);text-decoration:none;font-size:14px}.admin{padding:70px 0 100px;display:grid;grid-template-columns:1fr .9fr;gap:60px}.eyebrow{font-family:'DM Mono',monospace;text-transform:uppercase;letter-spacing:.1em;font-size:12px;color:var(--acid)}h1{font-size:clamp(50px,7vw,88px);letter-spacing:-.08em;line-height:.9;margin:20px 0 24px;max-width:600px}p{color:#b6b4bd;font-size:16px;line-height:1.5}.panel{background:#252631;border:1px solid #4a4a54;border-radius:20px;padding:24px}.drop{border:1px dashed #777681;border-radius:14px;min-height:170px;display:grid;place-items:center;text-align:center;color:#aaa8b2;padding:20px;cursor:pointer;position:relative;overflow:hidden}.drop:hover{border-color:var(--acid);color:var(--paper)}.drop input{position:absolute;inset:0;opacity:0;cursor:pointer}.preview{max-width:100%;max-height:200px;border-radius:10px;display:none}.field{margin-top:18px}.field label{font-size:13px;color:#d4d2d8;display:block;margin-bottom:8px}.field input{width:100%;background:#171821;border:1px solid #4a4a54;color:var(--paper);border-radius:9px;padding:13px;font:inherit;outline:0}.field input:focus{border-color:var(--acid)}.tag-row{display:flex;flex-wrap:wrap;gap:8px}.tag-option{border:1px solid #555560;color:#bbb9c2;background:transparent;border-radius:99px;padding:8px 12px;cursor:pointer}.tag-option.selected{background:var(--acid);border-color:var(--acid);color:var(--ink)}.submit{width:100%;border:0;border-radius:10px;background:var(--coral);color:var(--ink);font-weight:800;padding:14px;margin-top:22px;cursor:pointer}.submit:hover{filter:brightness(1.07);transform:translateY(-2px)}.side-title{display:flex;align-items:center;justify-content:space-between;margin:0 0 14px;font-size:18px}.mini-list{display:grid;gap:10px}.mini{display:flex;align-items:center;gap:12px;padding:11px;border-radius:10px;background:#30313d}.mini-art{width:48px;height:48px;display:grid;place-items:center;background:var(--lav);border-radius:8px;font-size:27px}.mini strong{font-size:14px}.mini small{display:block;color:#aaa8b2;margin-top:2px}.danger{margin-top:22px;color:#ff9eb3;background:transparent;border:0;cursor:pointer;font-size:12px}@media(max-width:800px){.shell{padding:0 18px}.admin{display:block;padding-top:48px}.admin .intro{margin-bottom:38px}}
    </style>
    <style is:global>
      .toast{position:fixed;z-index:20;right:24px;bottom:24px;display:flex;align-items:center;gap:12px;max-width:min(390px,calc(100vw - 36px));padding:14px 17px;border:1px solid var(--acid);border-radius:14px;background:var(--ink);color:var(--paper);box-shadow:6px 6px 0 var(--coral);font-size:14px;font-weight:600;opacity:0;transform:translateY(16px) scale(.98);pointer-events:none;transition:opacity .24s ease,transform .24s ease}.toast.show{opacity:1;transform:translateY(0) scale(1)}.toast-mark{display:grid;place-items:center;width:25px;height:25px;border-radius:8px;background:var(--acid);color:var(--ink);font-size:15px;flex:0 0 auto}@media(max-width:600px){.toast{right:14px;bottom:14px}}
    </style>
    <style is:global>
      [hidden]{display:none!important}.login-screen{min-height:calc(100vh - 83px);display:grid;place-items:center;padding:40px 18px}.login-card{width:min(420px,100%);background:#252631;border:1px solid #4a4a54;border-radius:20px;padding:30px;box-shadow:8px 8px 0 var(--coral)}.login-card h1{font-size:46px;margin:12px 0}.login-card p{margin:0 0 24px}.login-card label{display:block;font-size:13px;color:#d4d2d8;margin:16px 0 7px}.login-card input{width:100%;background:#171821;border:1px solid #4a4a54;color:var(--paper);border-radius:9px;padding:13px;font:inherit;outline:0}.login-card input:focus{border-color:var(--acid)}.login-button{width:100%;border:0;border-radius:10px;background:var(--acid);color:var(--ink);font-weight:800;padding:14px;margin-top:22px;cursor:pointer}.login-error{min-height:18px;color:#ff9eb3;font-size:13px;margin:12px 0 0}.logout{color:#ff9eb3;background:none;border:0;cursor:pointer;font-size:13px}.tag-create{display:flex;gap:8px;margin-top:12px}.tag-create input{flex:1;min-width:0}.tag-create button{border:1px solid var(--acid);background:var(--acid);color:var(--ink);border-radius:9px;padding:0 13px;font-weight:700;cursor:pointer}.tag-hint{display:block;color:#aaa8b2;font-size:12px;margin-top:8px}
    </style>
    <style is:global>
      .admin{display:block}.admin>.panel{width:100%}#mini-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.mini{display:block;padding:0;overflow:hidden;background:#30313d;border:1px solid #4a4a54;border-radius:16px}.mini-art{width:100%;aspect-ratio:1;height:auto;border-radius:0;background-color:#191a24;background-position:center;background-size:cover;background-repeat:no-repeat}.mini-body{padding:14px}.mini-body label{display:block;color:#aaa8b2;font-size:11px;margin:0 0 6px}.mini-body input{width:100%;background:#171821;border:1px solid #555560;color:var(--paper);border-radius:8px;padding:9px;font:inherit;font-size:13px;outline:0;margin-bottom:11px}.mini-body input:focus{border-color:var(--acid)}.mini-actions{display:flex;gap:8px}.mini-save{flex:1;border:1px solid var(--acid);background:var(--acid);color:var(--ink);border-radius:8px;padding:9px;font-weight:700;cursor:pointer}.mini-delete{border:1px solid #8d4e5d;background:transparent;color:#ff9eb3;border-radius:8px;padding:0 10px;cursor:pointer}.mini-delete:hover{background:#4a2631}.mini-replace{display:block;width:max-content;margin:-42px 10px 14px;position:relative;border:1px solid #777681;background:var(--ink);color:var(--paper);border-radius:8px;padding:8px 10px;font-size:11px;cursor:pointer}.mini-replace input{display:none}.mini small{display:block;color:#aaa8b2;margin-top:2px}@media(max-width:950px){#mini-list{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:680px){#mini-list{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:440px){#mini-list{grid-template-columns:1fr}}
    </style>
    <style is:global>
      #admin-main{display:grid!important;grid-template-columns:1fr .9fr!important;gap:60px!important}.intro{grid-column:1;grid-row:1}.admin>.panel{grid-column:2;grid-row:1;max-width:none;align-self:start}.works-section{grid-column:1/-1;grid-row:2;width:100%;margin-bottom:34px}.works-section .side-title{margin-bottom:18px}.works-section .danger{margin-top:16px}.upload-form{grid-template-columns:230px 1fr;gap:24px}.drop{min-height:230px}.preview{height:230px}.mini{display:block!important;overflow:visible!important}.mini-art{display:block!important;width:100%!important;height:210px!important;min-height:0;border-radius:0}.mini-body{display:block!important}.mini-actions{display:flex;min-width:0;gap:8px}.mini-save,.mini-delete{min-width:0;white-space:nowrap}.mini-delete{padding:9px 10px}#mini-list{grid-template-columns:repeat(3,minmax(0,1fr))!important}@media(max-width:800px){#admin-main{display:block!important}.intro,.admin>.panel,.works-section{display:block;grid-column:auto;grid-row:auto}.works-section{margin-top:34px}}@media(max-width:680px){#mini-list{grid-template-columns:repeat(2,minmax(0,1fr))!important}}@media(max-width:440px){#mini-list{grid-template-columns:1fr!important}}
    </style>
    <style is:global>
      .mini{position:relative;overflow:hidden!important}.mini-art{position:relative;height:220px!important;overflow:hidden;background:#191a24}.mini-image{display:block;width:100%;height:100%;object-fit:cover;object-position:center}.mini-more{position:absolute;right:10px;top:10px;width:36px;height:36px;border:1px solid rgba(255,255,255,.35);border-radius:50%;background:rgba(25,26,36,.88);color:var(--paper);font-size:18px;line-height:1;letter-spacing:2px;cursor:pointer}.mini-more:hover{background:var(--acid);color:var(--ink)}.mini-menu{position:absolute;z-index:3;right:10px;top:52px;display:grid;min-width:130px;padding:6px;border:1px solid #777681;border-radius:10px;background:#191a24;box-shadow:5px 5px 0 rgba(0,0,0,.2)}.mini-menu button{border:0;border-radius:7px;background:transparent;color:var(--paper);padding:9px 10px;text-align:left;font:inherit;font-size:12px;cursor:pointer}.mini-menu button:hover{background:#30313d}.mini-menu .mini-delete{color:#ff9eb3}.mini-body{padding:14px!important}.mini-title-view{display:block;font-size:18px;letter-spacing:-.03em}.mini-tags-view{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;color:#aaa8b2;font:10px 'DM Mono',monospace;text-transform:uppercase}.mini-editor{margin-top:14px;padding-top:14px;border-top:1px solid #4a4a54}.mini-editor label{display:block;color:#aaa8b2;font-size:11px;margin:0 0 6px}.mini-editor input{width:100%;background:#171821;border:1px solid #555560;color:var(--paper);border-radius:8px;padding:9px;font:inherit;font-size:13px;outline:0;margin-bottom:11px}.mini-editor input:focus{border-color:var(--acid)}.mini-editor-actions{display:flex;gap:8px}.mini-editor-actions button{flex:1;border-radius:8px;padding:9px;font-weight:700;cursor:pointer}.mini-save{border:1px solid var(--acid);background:var(--acid);color:var(--ink)}.mini-cancel{border:1px solid #777681;background:transparent;color:var(--paper)}
    </style>
    <style is:global>
      .works-tools{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:18px}.works-tools .side-title{margin:0}.works-search{width:min(320px,100%);background:#171821;border:1px solid #4a4a54;color:var(--paper);border-radius:99px;padding:10px 14px;font:14px Outfit,system-ui,sans-serif;outline:0}.works-search:focus{border-color:var(--acid);box-shadow:0 0 0 3px rgba(199,255,72,.12)}@media(max-width:600px){.works-tools{display:block}.works-search{width:100%;margin-top:12px}}
    </style>
    <style is:global>
      .admin#admin-main{display:block!important;max-width:1120px!important;padding-top:44px!important}.admin#admin-main>.intro{display:none!important}.admin#admin-main>.panel{display:block!important;width:min(980px,100%)!important;margin:0 auto!important;grid-column:auto!important;grid-row:auto!important;box-shadow:0 18px 50px rgba(0,0,0,.18);animation:panel-in .55s ease both}.topbar .logout{display:inline-flex;align-items:center;margin-left:18px;color:var(--paper);background:var(--coral);border:1px solid var(--coral);border-radius:99px;padding:10px 14px;font-size:13px;font-weight:700}.topbar .logout:hover{background:var(--acid);border-color:var(--acid);color:var(--ink);transform:translateY(-2px)}.topbar{gap:18px}.topbar .back{margin-left:auto}.drop{background:linear-gradient(135deg,rgba(199,255,72,.08),rgba(255,107,139,.08));transition:border-color .2s,background .2s,transform .2s}.drop:hover{background:linear-gradient(135deg,rgba(199,255,72,.18),rgba(255,107,139,.16));transform:translateY(-3px)}.tag-row{width:100%;padding:4px 0}.tag-option{transition:transform .18s,background .18s,border-color .18s,box-shadow .18s}.tag-option:hover{transform:translateY(-2px);border-color:var(--coral);box-shadow:3px 3px 0 var(--coral)}.tag-option.selected{box-shadow:3px 3px 0 var(--ink);animation:tag-pop .22s ease both}.submit{transition:transform .2s,box-shadow .2s}.submit:hover{box-shadow:5px 5px 0 var(--acid)}.works-section{margin-top:64px!important;padding-top:34px;border-top:1px solid #4a4a54}.works-tools .side-title{gap:12px}.works-tools{margin-bottom:22px!important}@keyframes panel-in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}@keyframes tag-pop{from{transform:scale(.94)}to{transform:scale(1)}}@media(max-width:800px){.admin#admin-main{padding-top:26px!important}.topbar .logout{padding:8px 11px;font-size:12px}.topbar .back{font-size:12px}.works-section{margin-top:46px!important;padding-top:26px}}
    </style>
  </head>
  <body>
    <header class="shell topbar"><a class="brand" href="/dibujis.html"><span class="brand-mark">✦</span> seviyummy</a><a class="back" href="/dibujis.html">← back to gallery</a></header>
    <section id="login-screen" class="login-screen"><form id="login-form" class="login-card"><span class="eyebrow">studio / private access</span><h1>Hello, artist.</h1><p>Sign in to upload new artwork to the gallery.</p><label for="login-user">Username</label><input id="login-user" autocomplete="username" required placeholder="abc" /><label for="login-pass">Password</label><input id="login-pass" type="password" autocomplete="current-password" required placeholder="123" /><button id="login-submit" class="login-button" type="button">Enter studio ↗</button><div id="login-error" class="login-error" role="status" aria-live="polite"></div></form></section>
    <main id="admin-main" class="shell admin" hidden><section class="intro"><span class="eyebrow">studio / carga de obra</span><h1>Sumá un nuevo dibujito.</h1><p>Subí la imagen, elegí todos los universos a los que pertenece y publicalo en la galería. Los cambios se guardan en este navegador.</p><button id="logout" class="logout" type="button">Cerrar sesión</button></section><section class="panel"><form id="form"><div class="drop" id="drop"><input id="file" type="file" accept="image/*" /><div id="drop-copy">Arrastrá una imagen o <u>elegí un archivo</u><br /><small>PNG, JPG o WEBP · máximo recomendado 5 MB</small></div><img id="preview" class="preview" alt="Previsualización de la obra" /></div><div class="field"><label for="title">Nombre de la obra</label><input id="title" required placeholder="Ej: Pikachu brujita" /></div><div class="field"><label>Tags visibles — elegí uno o varios</label><div class="tag-row" id="tag-row"></div><div class="tag-create"><input id="new-tag" placeholder="Crear tag nuevo" maxlength="24" /><button id="add-tag" type="button">Agregar</button></div><small class="tag-hint">Se muestran todos los tags visibles creados o usados.</small></div><button class="submit" type="submit">Publicar en la galería ↗</button></form><div style="height:1px;background:#41414b;margin:28px 0"></div><h2 class="side-title">Obras agregadas <span id="total" style="color:var(--acid);font:12px 'DM Mono'">0</span></h2><div id="works-search-wrap"><input id="works-search" class="works-search" type="search" placeholder="Buscar por nombre o tag…" autocomplete="off" /></div><div id="mini-list" class="mini-list"></div><button id="clear" class="danger" type="button">Borrar obras de este dispositivo</button></section></main><div id="toast" class="toast" role="status" aria-live="polite"><span class="toast-mark">✦</span><span id="toast-message"></span></div>
    <script>
      const authKey='mochi-moon-auth', loginForm=document.querySelector('#login-form'), loginScreen=document.querySelector('#login-screen'), adminMain=document.querySelector('#admin-main');
      function unlock(){loginScreen.hidden=true;adminMain.hidden=false;const logout=document.querySelector('#logout');if(logout){document.querySelector('.topbar').append(logout);logout.hidden=false}}
      if(sessionStorage.getItem(authKey)==='ok') unlock();
      function tryLogin(){const user=document.querySelector('#login-user').value.trim();const pass=document.querySelector('#login-pass').value;if(user==='abc'&&pass==='123'){sessionStorage.setItem(authKey,'ok');document.querySelector('#login-error').textContent='';unlock()}else document.querySelector('#login-error').textContent='Usuario o contraseña incorrectos.'}
      document.querySelector('#login-submit').addEventListener('click',tryLogin);loginForm.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();tryLogin()}});
      document.querySelector('#logout').addEventListener('click',()=>{sessionStorage.removeItem(authKey);adminMain.hidden=true;loginScreen.hidden=false;document.querySelector('.topbar #logout')?.setAttribute('hidden','');loginForm.reset()});
      const key='mochi-moon-art', tagKey='mochi-moon-tags', hiddenTagKey='mochi-moon-hidden-tags', defaultTags=['anime','pokemon','halloween','cute','fanart','original'], form=document.querySelector('#form'), file=document.querySelector('#file'), preview=document.querySelector('#preview'), dropCopy=document.querySelector('#drop-copy'), tagRow=document.querySelector('#tag-row'), toast=document.querySelector('#toast'), toastMessage=document.querySelector('#toast-message'), worksSearch=document.querySelector('#works-search'); let image=''; let tags=[]; let hiddenTags=[]; let toastTimer;const normalizeTag=value=>value.trim().toLowerCase().replace(/^#/,'').replace(/\s+/g,'-');const hiddenField=document.createElement('div');hiddenField.className='field hidden-tags-field';hiddenField.innerHTML='<label>Tags invisibles recientes <small>(para búsqueda interna, no aparecen en la galería)</small></label><div class="tag-row" id="hidden-tag-row"></div><label for="hidden-tags" class="tag-hint">Agregar tags invisibles manualmente</label><input id="hidden-tags" placeholder="Ej: regalo, cliente, personaje" /><small class="tag-hint">Se muestran los últimos 10 tags invisibles usados.</small>';tagRow.closest('.field').after(hiddenField);const hiddenTagRow=document.querySelector('#hidden-tag-row');
      function showToast(message){toastMessage.textContent=message;toast.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.remove('show'),3200)}
      function getTags(){const saved=JSON.parse(localStorage.getItem(tagKey)||'[]');const fromWorks=JSON.parse(localStorage.getItem(key)||'[]').flatMap(x=>x.tags||[]);return [...new Set(saved.concat(fromWorks,defaultTags))]}
      function getHiddenTags(){const saved=JSON.parse(localStorage.getItem(hiddenTagKey)||'[]');const fromWorks=JSON.parse(localStorage.getItem(key)||'[]').flatMap(x=>x.hiddenTags||[]);return [...new Set(saved.concat(fromWorks))].slice(0,10)}
      function saveTags(list){localStorage.setItem(tagKey,JSON.stringify([...new Set(list)]))}
      function saveHiddenTags(list){localStorage.setItem(hiddenTagKey,JSON.stringify([...new Set(list)].slice(0,10)))}
      function renderTags(){tagRow.innerHTML=getTags().map(t=>`<button type="button" class="tag-option${tags.includes(t)?' selected':''}" data-tag="${t}">#${t}</button>`).join('');tagRow.querySelectorAll('.tag-option').forEach(b=>b.addEventListener('click',()=>{b.classList.toggle('selected');tags=[...tagRow.querySelectorAll('.selected')].map(x=>x.dataset.tag)}));hiddenTagRow.innerHTML=getHiddenTags().map(t=>`<button type="button" class="tag-option hidden-tag-option${hiddenTags.includes(t)?' selected':''}" data-hidden-tag="${t}">#${t}</button>`).join('');hiddenTagRow.querySelectorAll('.hidden-tag-option').forEach(b=>b.addEventListener('click',()=>{b.classList.toggle('selected');hiddenTags=[...hiddenTagRow.querySelectorAll('.selected')].map(x=>x.dataset.hiddenTag)}))} renderTags();
      function createTag(){const input=document.querySelector('#new-tag');const value=input.value.trim().toLowerCase().replace(/^#/,'').replace(/\s+/g,'-');if(!value)return;saveTags([value,...getTags().filter(t=>t!==value)]);input.value='';renderTags();const created=tagRow.querySelector(`[data-tag="${value}"]`);if(created){created.classList.add('selected');tags=[...new Set([...tags,value])]}}
      document.querySelector('#add-tag').addEventListener('click',createTag);document.querySelector('#new-tag').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();createTag()}});
      file.addEventListener('change',()=>{const f=file.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{image=r.result;preview.src=image;preview.style.display='block';dropCopy.style.display='none'};r.readAsDataURL(f)});
      function list(){const data=JSON.parse(localStorage.getItem(key)||'[]');const query=(worksSearch?.value||'').trim().toLowerCase();const matches=data.map((x,i)=>({x,i})).filter(({x})=>{const haystack=[x.title,...(x.tags||[]),...(x.hiddenTags||[])].join(' ').toLowerCase();return !query||haystack.includes(query)});document.querySelector('#total').textContent=`${matches.length.toString().padStart(2,'0')} / ${data.length.toString().padStart(2,'0')}`;document.querySelector('#mini-list').innerHTML=matches.length?matches.map(({x,i})=>{const hiddenTags=x.hiddenTags||[];return `<article class="mini" data-index="${i}"><div class="mini-art"><img class="mini-image" src="${x.image}" alt="${x.title}" /><button class="mini-more" type="button" aria-label="Acciones para ${x.title}">•••</button><div class="mini-menu" hidden><button class="mini-edit" type="button">Editar</button><button class="mini-delete" type="button">Eliminar</button></div></div><div class="mini-body"><strong class="mini-title-view">${x.title}</strong><div class="mini-tags-view">${(x.tags||[]).map(t=>`#${t}`).join(' · ')}</div><div class="mini-editor" hidden><label for="mini-title-${i}">Nombre</label><input id="mini-title-${i}" class="mini-title" value="${x.title.replace(/"/g,'&quot;')}" /><label for="mini-tags-${i}">Tags visibles</label><input id="mini-tags-${i}" class="mini-tags" value="${(x.tags||[]).join(', ')}" /><label for="mini-hidden-tags-${i}">Tags invisibles</label><input id="mini-hidden-tags-${i}" class="mini-hidden-tags" value="${hiddenTags.join(', ')}" placeholder="Ej: regalo, cliente" /><label for="mini-file-${i}">Cambiar imagen</label><input id="mini-file-${i}" class="mini-file" type="file" accept="image/*" /><div class="mini-editor-actions"><button class="mini-save" type="button">Guardar</button><button class="mini-cancel" type="button">Cancelar</button></div></div></div></article>`}).join(''):'<div class="empty-works" style="grid-column:1/-1;border:1px dashed #777681;border-radius:14px;color:#aaa8b2;padding:40px;text-align:center">' + (query?'No encontramos obras con ese nombre o tag.':'Todavía no agregaste obras desde este dispositivo.') + '</div>'} list();
      const miniList=document.querySelector('#mini-list');miniList.addEventListener('change',e=>{if(!e.target.classList.contains('mini-file'))return;const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{const card=e.target.closest('.mini');card.querySelector('.mini-image').src=r.result;card.dataset.newImage=r.result};r.readAsDataURL(f)});miniList.addEventListener('click',e=>{const card=e.target.closest('.mini');if(!card)return;const index=Number(card.dataset.index),data=JSON.parse(localStorage.getItem(key)||'[]');if(e.target.classList.contains('mini-more')){miniList.querySelectorAll('.mini-menu').forEach(menu=>{if(menu!==card.querySelector('.mini-menu'))menu.hidden=true});card.querySelector('.mini-menu').hidden=!card.querySelector('.mini-menu').hidden}if(e.target.classList.contains('mini-edit')){card.querySelector('.mini-menu').hidden=true;card.querySelector('.mini-editor').hidden=false}if(e.target.classList.contains('mini-cancel')){card.querySelector('.mini-editor').hidden=true;delete card.dataset.newImage}if(e.target.classList.contains('mini-save')){const title=card.querySelector('.mini-title').value.trim();const nextTags=card.querySelector('.mini-tags').value.split(',').map(normalizeTag).filter(Boolean);const nextHiddenTags=card.querySelector('.mini-hidden-tags').value.split(',').map(normalizeTag).filter(Boolean);if(!title||!nextTags.length){showToast('Completá el nombre y al menos un tag visible.');return}data[index]={...data[index],title,tags:[...new Set(nextTags)],hiddenTags:[...new Set(nextHiddenTags)],image:card.dataset.newImage||data[index].image};localStorage.setItem(key,JSON.stringify(data));saveTags([...nextTags,...getTags()]);saveHiddenTags([...nextHiddenTags,...getHiddenTags()]);list();renderTags();showToast('Obra actualizada.')}if(e.target.classList.contains('mini-delete')){if(confirm('¿Eliminar esta obra de la galería?')){data.splice(index,1);localStorage.setItem(key,JSON.stringify(data));list();renderTags();showToast('Obra eliminada.')}}});
      form.addEventListener('submit',e=>{e.preventDefault();if(!image){showToast('Elegí una imagen antes de publicar.');return}if(!tags.length){showToast('Elegí al menos un tag visible.');return}const typedHiddenTags=document.querySelector('#hidden-tags').value.split(',').map(normalizeTag).filter(Boolean);const selectedHiddenTags=[...new Set([...hiddenTags,...typedHiddenTags])];const data=JSON.parse(localStorage.getItem(key)||'[]');data.unshift({title:document.querySelector('#title').value,image,tags,hiddenTags:selectedHiddenTags});localStorage.setItem(key,JSON.stringify(data));saveTags([...tags,...getTags().filter(t=>!tags.includes(t))]);saveHiddenTags([...selectedHiddenTags,...getHiddenTags()]);form.reset();image='';tags=[];hiddenTags=[];preview.style.display='none';dropCopy.style.display='block';renderTags();list();showToast('¡Obra publicada en la galería!')});document.querySelector('#clear').addEventListener('click',()=>{if(confirm('¿Borrar las obras guardadas en este dispositivo?')){localStorage.removeItem(key);localStorage.removeItem(hiddenTagKey);list();renderTags();showToast('Obras borradas de este dispositivo.')}});
      worksSearch.addEventListener('input',list);const panel=document.querySelector('.panel'),worksHeading=document.querySelector('.side-title'),worksSearchWrap=document.querySelector('#works-search-wrap'),worksGrid=document.querySelector('#mini-list'),clearWorks=document.querySelector('#clear'),divider=worksHeading&&worksHeading.previousElementSibling;if(divider)divider.remove();const worksSection=document.createElement('section');worksSection.className='works-section';panel.parentNode.append(worksSection);const worksTools=document.createElement('div');worksTools.className='works-tools';worksTools.append(worksHeading,worksSearchWrap);worksSection.append(worksTools,worksGrid,clearWorks);
      const localizeAdmin=()=>{const set=(selector,text)=>{const el=document.querySelector(selector);if(el&&el.textContent!==text)el.textContent=text};set('.back','← back to gallery');set('.login-card .eyebrow','studio / private access');set('.login-card h1','Hello, artist.');set('.login-card p','Sign in to upload new artwork to the gallery.');set('.login-card label[for="login-user"]','Username');set('.login-card label[for="login-pass"]','Password');set('#login-submit','Enter studio ↗');set('.intro .eyebrow','studio / artwork upload');set('.intro h1','Add new artwork.');set('.intro p','Upload an image, choose all the universes it belongs to, and publish it to the gallery. Changes are saved in this browser.');set('#logout','Log out');const drop=document.querySelector('#drop-copy');if(drop)drop.innerHTML='Drag an image or <u>choose a file</u><br /><small>PNG, JPG or WEBP · 5 MB recommended maximum</small>';const fields=document.querySelectorAll('#form > .field');if(fields[0])fields[0].querySelector('label').textContent='Artwork name';if(fields[1])fields[1].querySelector('label').textContent='Visible tags — choose one or more';const newTag=document.querySelector('#new-tag');if(newTag)newTag.placeholder='Create new tag';set('#add-tag','Add');const visibleHint=document.querySelector('#tag-row')?.parentElement?.querySelector('.tag-hint');if(visibleHint)visibleHint.textContent='All visible tags created or used are shown.';const hidden=document.querySelector('.hidden-tags-field');if(hidden){const label=hidden.querySelector('label:first-child');if(label)label.innerHTML='Recent hidden tags <small>(for internal search, not shown in the gallery)</small>';const manual=hidden.querySelector('label[for="hidden-tags"]');if(manual){manual.textContent='Add hidden tags manually';manual.className='tag-hint'}const hint=hidden.querySelector('small.tag-hint');if(hint)hint.textContent='The last 10 hidden tags used are shown.'}set('.submit','Publish to gallery ↗');const title=document.querySelector('.side-title');if(title&&title.firstChild)title.firstChild.textContent='Uploaded artwork ';const ws=document.querySelector('#works-search');if(ws)ws.placeholder='Search by name or tag…';set('#clear','Delete artwork from this device');document.querySelectorAll('.mini-more').forEach(el=>{const name=el.closest('.mini')?.querySelector('.mini-title-view')?.textContent||'artwork';el.setAttribute('aria-label',`Actions for ${name}`)});document.querySelectorAll('.mini-edit').forEach(el=>el.textContent='Edit');document.querySelectorAll('.mini-delete').forEach(el=>el.textContent='Delete');document.querySelectorAll('.mini-cancel').forEach(el=>el.textContent='Cancel');document.querySelectorAll('.mini-save').forEach(el=>el.textContent='Save');document.querySelectorAll('.mini-editor label').forEach(label=>{const text=label.getAttribute('for')||'';label.textContent=text.startsWith('mini-title-')?'Name':text.startsWith('mini-tags-')?'Visible tags':text.startsWith('mini-hidden-tags-')?'Hidden tags':'Change image'});const empty=document.querySelector('.empty-works');if(empty)empty.textContent=(ws?.value?'No artwork found with that name or tag.':'No artwork uploaded from this device yet.')};localizeAdmin();new MutationObserver(localizeAdmin).observe(document.querySelector('#mini-list'),{childList:true,subtree:true});
    </script>
  </body>
</html>
