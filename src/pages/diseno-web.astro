---
import SiteLayout from '../layouts/SiteLayout.astro';
import PclafHeader from '../components/PclafHeader.astro';
---
<SiteLayout title="Diseño web para negocios en CABA | PCLAF" description="Páginas web profesionales para negocios de CABA y AMBA: diseño responsive, WhatsApp, SEO y publicación.">
  <Fragment slot="head"><link rel="canonical" href="https://www.pclaf.com.ar/diseno-web.html" /></Fragment>
  <div class="web-page"><PclafHeader /><main>
    <section class="web-hero"><video autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="/assets/web-ui-motion-loop.mp4" type="video/mp4" /></video><div class="shade"></div><div class="web-hero-inner"><p class="eyebrow">PCLAF / DISEÑO DIGITAL</p><h1>Una web que<br /><em>tiene dirección.</em></h1><p>Diseñamos sitios para negocios que necesitan verse claros, diferentes y listos para recibir consultas.</p><div class="actions"><a class="red-btn" href="https://wa.me/5491135708345?text=Hola%2C%20quiero%20hacer%20una%20web" target="_blank" rel="noopener noreferrer">Hablemos de tu web ↗</a><a class="line-btn" href="#planes">Ver planes ↓</a></div></div></section>
    <section class="web-intro"><p class="eyebrow">DE LA IDEA A LA PANTALLA</p><h2>Diseño con intención,<br /><em>no una plantilla más.</em></h2><p>Ordenamos el mensaje, la estética y el recorrido para que tu web explique lo que hacés y ayude a que te elijan.</p></section>
    <section class="web-showcase"><article><div class="browser"><span></span><span></span><span></span><div class="screen screen-red"><small>MARCA / 01</small><b>Que se<br /><em>note.</em></b><i></i></div></div><h3>Landing comercial</h3><p>Para marcas que necesitan diferenciarse y vender mejor.</p></article><article><div class="browser"><span></span><span></span><span></span><div class="screen screen-green"><small>SISTEMA / 02</small><b>Todo<br /><em>conectado.</em></b><i></i></div></div><h3>Sitio con sistema</h3><p>Una presencia digital ordenada para explicar servicios y recibir consultas.</p></article></section>
    <section class="web-plans" id="planes"><div class="plans-head"><p class="eyebrow">PLANES DE DISEÑO WEB</p><h2>Elegí según<br /><em>lo que necesitás.</em></h2></div><div class="plans"><article><small>BASE</small><h3>Landing esencial</h3><p>Una página clara para mostrar qué hacés y recibir consultas.</p><strong>Desde USD 250</strong><a href="https://wa.me/5491135708345?text=Hola%2C%20quiero%20consultar%20por%20la%20Landing%20esencial" target="_blank" rel="noopener noreferrer">Consultar ↗</a></article><article class="featured"><small>MÁS ELEGIDO</small><h3>Landing comercial</h3><p>Diseño y arquitectura a medida para marcas que necesitan verse diferentes.</p><strong>Desde USD 450</strong><a href="https://wa.me/5491135708345?text=Hola%2C%20quiero%20consultar%20por%20la%20Landing%20comercial" target="_blank" rel="noopener noreferrer">Consultar ↗</a></article><article><small>MARCA</small><h3>Sitio institucional</h3><p>Hasta cinco páginas para explicar tu marca, servicios y propuesta.</p><strong>Desde USD 650</strong><a href="https://wa.me/5491135708345?text=Hola%2C%20quiero%20consultar%20por%20el%20Sitio%20institucional" target="_blank" rel="noopener noreferrer">Consultar ↗</a></article></div></section>
    <section class="web-process"><p class="eyebrow">CÓMO LO HACEMOS</p><h2>De la referencia<br /><em>a una web que funciona.</em></h2><div class="steps"><div><b>01</b><strong>Elegís una dirección</strong><p>Partimos de lo que te gusta y de lo que tu negocio necesita.</p></div><div><b>02</b><strong>La llevamos a tu marca</strong><p>Adaptamos colores, textos, imágenes y secciones.</p></div><div><b>03</b><strong>La dejamos lista</strong><p>Responsive, publicada y con una acción clara.</p></div></div></section>
  </main><footer><span>© 2026 PCLAF</span><span>Diseño web / CABA</span><a href="mailto:pclaf@gmail.com">pclaf@gmail.com</a></footer></div>
</SiteLayout>
<style>
  :global(:root){--bg:#151719;--ink:#f2eee7;--red:#e12b24;--green:#53d88e;--muted:#aaa39b;--line:#3d4143;--mono:'DM Mono',monospace;--sans:'Space Grotesk',sans-serif}:global(*){box-sizing:border-box}:global(body){margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans)}:global(a){color:inherit;text-decoration:none}.web-page{min-height:100vh;background:var(--bg)}.web-hero{position:relative;min-height:590px;overflow:hidden;border-bottom:1px solid var(--line)}.web-hero video,.web-hero .shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.web-hero video{opacity:.6;filter:contrast(1.12) saturate(.75)}.shade{background:linear-gradient(90deg,rgba(10,11,12,.96),rgba(10,11,12,.62) 55%,rgba(10,11,12,.2))}.web-hero-inner{position:relative;padding:clamp(90px,12vw,150px) clamp(20px,8vw,140px)}.eyebrow{margin:0 0 28px;color:var(--red);font:11px var(--mono);letter-spacing:.13em}.web-hero h1,.web-intro h2,.plans-head h2,.web-process h2{margin:0;font-size:clamp(58px,8vw,110px);line-height:.84;letter-spacing:-.1em;font-weight:500}.web-hero h1 em,.web-intro h2 em,.plans-head h2 em,.web-process h2 em{color:var(--red);font-style:italic}.web-hero p:not(.eyebrow){max-width:600px;margin:34px 0 0;color:#d1cfca;font-size:20px;line-height:1.45}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}.red-btn,.line-btn,.plans a{padding:16px 20px;font:11px var(--mono);letter-spacing:.08em;text-transform:uppercase}.red-btn{background:var(--red)}.line-btn{border:1px solid #777}.web-intro{display:grid;grid-template-columns:70px 1fr 280px;gap:30px;align-items:end;padding:clamp(90px,12vw,160px) clamp(20px,8vw,140px) 65px}.web-intro h2{font-size:clamp(48px,6vw,84px)}.web-intro>p:last-child{margin:0;color:var(--muted);line-height:1.5}.web-showcase{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:0 clamp(20px,8vw,140px) 130px}.browser{padding:10px;background:#202427;border:1px solid var(--line)}.browser>span{display:inline-block;width:7px;height:7px;margin:0 4px 9px 0;border-radius:50%;background:#6c7374}.screen{height:300px;padding:28px;position:relative;overflow:hidden}.screen-red{background:var(--red)}.screen-green{background:var(--green);color:#07120d}.screen small{font:10px var(--mono);letter-spacing:.1em}.screen b{display:block;margin-top:70px;font-size:58px;line-height:.84;letter-spacing:-.1em;font-weight:500}.screen em{font-style:italic}.screen i{position:absolute;right:-45px;bottom:-70px;width:190px;height:190px;border-radius:50%;background:rgba(255,255,255,.17)}.web-showcase h3{margin:22px 0 5px;font-size:27px;font-weight:500;letter-spacing:-.06em}.web-showcase p{margin:0;color:var(--muted)}.web-plans{padding:0 clamp(20px,8vw,140px) 145px}.plans-head{display:grid;grid-template-columns:70px 1fr;margin-bottom:55px}.plans-head h2{font-size:clamp(48px,6vw,82px)}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.plans article{display:flex;flex-direction:column;min-height:330px;padding:28px;background:#1b1e20;border:1px solid var(--line)}.plans article.featured{background:var(--red);border-color:var(--red)}.plans small{font:10px var(--mono);color:var(--red);letter-spacing:.1em}.plans .featured small{color:#2b0806}.plans h3{margin:32px 0 14px;font-size:33px;line-height:.9;letter-spacing:-.07em;font-weight:500}.plans p{color:#b9b9b3;line-height:1.5}.plans .featured p{color:#fff}.plans strong{margin-top:auto;font:13px var(--mono)}.plans a{display:inline-block;margin-top:20px;border:1px solid currentColor;text-align:center}.web-process{padding:0 clamp(20px,8vw,140px) 140px}.web-process h2{font-size:clamp(48px,6vw,82px)}.steps{margin-top:60px;border-top:1px solid var(--line)}.steps>div{display:grid;grid-template-columns:60px 1fr;gap:12px;padding:22px 0;border-bottom:1px solid var(--line)}.steps b{color:var(--red);font:11px var(--mono)}.steps strong{font-size:24px;font-weight:500}.steps p{grid-column:2;margin:0;color:var(--muted)}.web-page footer{display:flex;justify-content:space-between;gap:20px;padding:24px clamp(20px,8vw,140px);background:#0b0d0e;color:#858b8d;font:10px var(--mono)}.web-page footer a{color:var(--ink)}
  @media(max-width:800px){.web-intro{grid-template-columns:1fr}.web-intro>p:last-child{max-width:320px;margin-top:15px}.web-showcase,.plans{grid-template-columns:1fr}.plans-head{grid-template-columns:1fr}.web-page footer{flex-wrap:wrap}.web-page footer span:nth-child(2){display:none}}@media(max-width:520px){.web-hero-inner{padding:70px 18px}.web-hero h1{font-size:61px}.web-hero p:not(.eyebrow){font-size:17px}.web-intro,.web-showcase,.web-plans,.web-process{padding-left:18px;padding-right:18px}.screen{height:260px}.web-page footer{padding:20px 18px}}
</style>
