---
import SiteLayout from '../layouts/SiteLayout.astro';
import PclafHeader from '../components/PclafHeader.astro';
---

<SiteLayout title="Revisión y diagnóstico de PC en Floresta | PCLAF" description="Revisión y diagnóstico de PC y notebook en Floresta. Detectamos el problema y te decimos qué conviene hacer antes de avanzar.">
  <Fragment slot="head"><link rel="canonical" href="https://www.pclaf.com.ar/diagnostico-pc-notebook-floresta.html" /><meta name="robots" content="index, follow" /></Fragment>
  <div class="diagnostic-page">
    <PclafHeader />
    <main>
      <section class="diagnostic-hero" aria-labelledby="diagnostic-title">
        <video class="diagnostic-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="/assets/pc-hardware-loop.mp4" type="video/mp4" /></video><div class="hero-shade"></div>
        <div class="hero-inner"><p class="eyebrow"><span></span> PCLAF / DIAGNÓSTICO TÉCNICO</p><div class="hero-grid"><div><h1 id="diagnostic-title">Primero<br /><em>entendemos</em><br />el problema.</h1><p class="hero-lead">Si tu PC o notebook no prende, se congela, se apaga o hace cosas raras, la revisamos y te decimos qué conviene hacer antes de tocar nada.</p><div class="hero-actions"><a class="action-primary" href="/turnos.html">Pedir turno <b>↗</b></a><a class="action-secondary" href="https://wa.me/5491135708345?text=Hola%2C%20quiero%20consultar%20por%20un%20diagnostico" target="_blank" rel="noopener noreferrer">Consultar por WhatsApp <b>↗</b></a></div></div><div class="hero-note"><span class="note-line"></span><strong>Diagnóstico<br />sin vueltas.</strong><small>Presupuesto antes<br />de avanzar.</small></div></div></div>
      </section>
      <section class="diagnostic-stats" aria-label="Información del servicio"><div><b>01</b><span>revisión completa</span></div><div><b>02</b><span>problema explicado</span></div><div><b>03</b><span>valor antes de reparar</span></div><div class="stats-place"><b>FLORESTA</b><span>Campana 51, CABA</span></div></section>
      <section class="diagnostic-content" aria-labelledby="review-title"><div class="section-heading"><p class="eyebrow"><span></span> QUÉ REVISAMOS</p><h2 id="review-title">Antes de reparar,<br /><em>hay que entender.</em></h2><p>Una revisión clara evita cambiar piezas sin necesidad y te permite decidir con información.</p></div><div class="diagnostic-cards"><article class="diagnostic-card diagnostic-card-wide"><small>01 / ESTADO GENERAL</small><h3>Primero entendemos el problema.</h3><ul><li>Encendido, estabilidad y comportamiento general.</li><li>Temperaturas, ruidos y síntomas de hardware.</li><li>Estado de disco, memoria y arranque.</li><li>Errores visibles de sistema o software.</li></ul></article><article class="diagnostic-card diagnostic-card-red"><small>02 / IDEAL SI</small><h3>No sabés cuál es la falla.</h3><p>Querés evitar gastar de más o necesitás que te expliquen con claridad qué tiene el equipo antes de avanzar.</p></article><article class="diagnostic-card"><small>03 / SIN VUELTAS</small><h3>Te decimos qué conviene.</h3><p>Si no conviene arreglarlo, también te lo decimos. El diagnóstico sirve para elegir el siguiente paso.</p></article><article class="diagnostic-card diagnostic-card-dark"><small>04 / DESPUÉS</small><h3>Vos decidís si seguimos.</h3><p>Limpieza, pasta térmica, optimización, formateo, cambio de disco, memoria o reparación de hardware: siempre con valor previo.</p></article></div></section>
      <section class="diagnostic-process" aria-labelledby="process-title"><div class="process-intro"><p class="eyebrow"><span></span> EL PROCESO</p><h2 id="process-title">Del síntoma<br /><em>a una decisión clara.</em></h2></div><div class="process-list"><div><b>01</b><strong>Traés el equipo</strong><p>Nos contás qué está pasando y qué necesitás resolver.</p></div><div><b>02</b><strong>Lo revisamos</strong><p>Buscamos la causa real, no solo el síntoma visible.</p></div><div><b>03</b><strong>Te explicamos</strong><p>Recibís un diagnóstico y un valor antes de avanzar.</p></div></div></section>
      <section class="diagnostic-cta"><p class="eyebrow"><span></span> ¿NO SABÉS QUÉ TIENE?</p><h2>Traelo.<br /><em>Lo vemos.</em></h2><a class="action-primary" href="/turnos.html">Pedir turno <b>↗</b></a></section>
    </main>
    <footer class="diagnostic-footer"><span>© 2026 PCLAF</span><span>Floresta / Flores / CABA</span><a href="mailto:pclaf@gmail.com">pclaf@gmail.com</a></footer>
  </div>
</SiteLayout>

<style>
  :global(:root){--paper:#151719;--ink:#f2eee7;--red:#e12b24;--green:#53d88e;--muted:#aaa39b;--line:#3d4143;--mono:'DM Mono',monospace;--sans:'Space Grotesk',sans-serif}:global(*){box-sizing:border-box}:global(body){margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans)}:global(a){color:inherit;text-decoration:none}.diagnostic-page{min-height:100vh;background:var(--paper)}
  .diagnostic-hero{position:relative;min-height:620px;overflow:hidden;border-bottom:1px solid var(--ink)}.diagnostic-video,.hero-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.diagnostic-video{opacity:.5;filter:contrast(1.12) saturate(.75)}.hero-shade{background:linear-gradient(90deg,rgba(7,8,9,.95),rgba(7,8,9,.7) 48%,rgba(7,8,9,.18)),linear-gradient(180deg,rgba(225,43,36,.2),transparent 44%)}.hero-inner{position:relative;z-index:1;padding:clamp(70px,9vw,125px) clamp(20px,8vw,140px) 72px}.eyebrow{display:flex;align-items:center;gap:12px;margin:0 0 30px;color:var(--red);font:11px var(--mono);letter-spacing:.13em}.eyebrow span{width:38px;height:1px;background:currentColor}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) 240px;gap:40px;align-items:end}.hero-grid h1{max-width:760px;margin:0;font-size:clamp(62px,9vw,132px);line-height:.82;letter-spacing:-.1em;font-weight:500}.hero-grid h1 em,.section-heading h2 em,.process-intro h2 em,.diagnostic-cta h2 em{color:var(--red);font-style:italic}.hero-lead{max-width:610px;margin:34px 0 0;color:#d1cfca;font-size:clamp(17px,2vw,22px);line-height:1.4}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}.action-primary,.action-secondary{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;padding:16px 20px;font:11px var(--mono);letter-spacing:.08em;text-transform:uppercase}.action-primary{background:var(--red);color:#fff}.action-secondary{border:1px solid #6a6d6d;background:rgba(10,11,12,.5);color:var(--ink)}.action-primary b,.action-secondary b{font:19px var(--sans)}.hero-note{align-self:end;display:flex;flex-direction:column;gap:14px;padding-bottom:6px;font-family:var(--mono);text-transform:uppercase}.note-line{display:block;width:45px;height:5px;background:var(--red)}.hero-note strong{font-size:13px;line-height:1.35}.hero-note small{color:var(--muted);font-size:10px;line-height:1.4}
  .diagnostic-stats{display:grid;grid-template-columns:repeat(3,1fr) 1.4fr;padding:0 clamp(20px,8vw,140px);border-bottom:1px solid var(--line)}.diagnostic-stats>div{display:flex;flex-direction:column;gap:7px;padding:25px 20px 25px 0;border-right:1px solid var(--line);margin-right:20px}.diagnostic-stats b{font-size:30px;font-weight:500;letter-spacing:-.08em}.diagnostic-stats span{color:var(--muted);font:10px var(--mono);letter-spacing:.08em;text-transform:uppercase}.diagnostic-stats .stats-place{border-right:0;margin-right:0}.stats-place b{color:var(--green);font:13px var(--mono);letter-spacing:.08em}
  .diagnostic-content{padding:clamp(90px,12vw,165px) clamp(20px,8vw,140px)}.section-heading{display:grid;grid-template-columns:70px minmax(0,1fr) 260px;gap:30px;align-items:end;margin-bottom:65px}.section-heading .eyebrow{align-self:start}.section-heading h2{margin:0;font-size:clamp(48px,6vw,84px);line-height:.86;letter-spacing:-.09em;font-weight:500}.section-heading>p:last-child{margin:0 0 4px;color:var(--muted);font-size:15px;line-height:1.5}.diagnostic-cards{display:grid;grid-template-columns:1.25fr .75fr;gap:14px}.diagnostic-card{min-height:220px;padding:28px;background:#1b1e20;border:1px solid var(--line)}.diagnostic-card-wide{grid-row:span 2;min-height:455px}.diagnostic-card-red{background:var(--red);border-color:var(--red);color:#fff}.diagnostic-card-dark{background:#08090a}.diagnostic-card small{display:block;margin-bottom:26px;color:var(--red);font:10px var(--mono);letter-spacing:.1em}.diagnostic-card-red small{color:#2b0806}.diagnostic-card h3{max-width:480px;margin:0 0 22px;font-size:clamp(28px,3.5vw,48px);line-height:.9;letter-spacing:-.07em;font-weight:500}.diagnostic-card p,.diagnostic-card li{max-width:520px;color:#b9b9b3;font-size:16px;line-height:1.6}.diagnostic-card-red p{color:#fff}.diagnostic-card ul{display:grid;gap:13px;margin:0;padding:0;list-style:none}.diagnostic-card li{padding-left:18px}.diagnostic-card li::before{content:'+';margin-left:-18px;margin-right:9px;color:var(--red);font-family:var(--mono)}
  .diagnostic-process{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;padding:0 clamp(20px,8vw,140px) clamp(100px,12vw,170px)}.process-intro h2{margin:0;font-size:clamp(48px,6vw,82px);line-height:.86;letter-spacing:-.09em;font-weight:500}.process-list{border-top:1px solid var(--line)}.process-list>div{display:grid;grid-template-columns:50px 1fr;gap:12px;padding:22px 0;border-bottom:1px solid var(--line)}.process-list b{color:var(--red);font:11px var(--mono)}.process-list strong{font-size:24px;font-weight:500;letter-spacing:-.05em}.process-list p{grid-column:2;margin:0;color:var(--muted);font-size:14px}.diagnostic-cta{display:grid;grid-template-columns:1fr 1fr auto;align-items:center;gap:30px;padding:55px clamp(20px,8vw,140px);background:var(--red);color:#fff}.diagnostic-cta .eyebrow{color:#2b0806;margin:0}.diagnostic-cta h2{margin:0;font-size:clamp(42px,5vw,70px);line-height:.85;letter-spacing:-.09em;font-weight:500}.diagnostic-cta h2 em{color:#2b0806}.diagnostic-cta .action-primary{background:#2b0806}.diagnostic-footer{display:flex;justify-content:space-between;gap:20px;padding:24px clamp(20px,8vw,140px);background:#0b0d0e;color:#858b8d;font:10px var(--mono);letter-spacing:.05em}.diagnostic-footer a{color:var(--ink)}
  @media(max-width:800px){.hero-grid,.section-heading,.diagnostic-process,.diagnostic-cta{grid-template-columns:1fr}.hero-note{display:none}.diagnostic-stats{grid-template-columns:repeat(2,1fr)}.diagnostic-stats .stats-place{grid-column:span 2;border-top:1px solid var(--line);padding-top:20px}.section-heading>p:last-child{max-width:320px;margin-top:15px}.diagnostic-cards{grid-template-columns:1fr}.diagnostic-card-wide{grid-row:auto;min-height:0}.diagnostic-process{gap:45px}.diagnostic-cta .action-primary{justify-self:start}.diagnostic-footer{flex-wrap:wrap}.diagnostic-footer span:nth-child(2){display:none}}
  @media(max-width:520px){.hero-inner{padding:60px 18px 50px}.diagnostic-hero{min-height:650px}.hero-grid h1{font-size:58px}.hero-lead{font-size:17px}.diagnostic-stats{padding:0 18px}.diagnostic-content{padding:85px 18px}.diagnostic-process{padding:0 18px 90px}.diagnostic-cta{padding:45px 18px}.diagnostic-footer{padding:20px 18px}}
</style>
