---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/Navigation.astro';
---
<SiteLayout title="PCLAF — Servicio técnico que responde" description="Reparamos PC, notebooks y equipos gamer en Floresta. Diagnóstico claro, presupuesto antes de reparar y atención humana.">
  <Navigation />
  <main>
    <section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span> Taller abierto · Floresta, CABA</p><h1>Tu equipo<br /><em>vuelve a rendir.</em></h1><p class="hero-text">Servicio técnico de PC, notebooks y equipos gamer. Diagnóstico honesto, reparación precisa y cero vueltas.</p><div class="hero-actions"><a class="btn btn-dark" href="/turnos.html">Reservar turno <span>→</span></a><a class="under-link" href="#servicios">Ver servicios</a></div><div class="trust-row"><span><b>★</b> 4.9 / 5</span><span>+10 años resolviendo</span><span>Presupuesto previo</span></div></div><div class="hero-image"><img src="/images/pclaf-hardware.png" alt="Técnico reparando una placa madre de PC" /><div class="image-note"><span class="live-dot"></span><strong>DIAGNÓSTICO EN CURSO</strong><small>Atención personalizada</small></div></div></section>
    <section class="ticker" aria-label="Especialidades"><span>PC & NOTEBOOK</span><i>✦</i><span>GAMER</span><i>✦</i><span>WINDOWS</span><i>✦</i><span>LIMPIEZA</span><i>✦</i><span>UPGRADE</span></section>
    <section class="services section" id="servicios"><div class="section-intro"><p class="eyebrow">Lo que hacemos</p><h2>El problema cambia.<br /><em>La respuesta, no.</em></h2><p>Desde una notebook lenta hasta una PC gamer que pide más. Nos ocupamos de que tu tecnología acompañe tu ritmo.</p></div><div class="service-grid"><a class="service-card featured" href="/diagnostico-pc-notebook-floresta.html"><span class="card-number">01</span><h3>Diagnóstico<br />y reparación</h3><p>Encontramos qué falla y te contamos cómo resolverlo antes de tocar nada.</p><span class="card-link">Conocer más →</span></a><a class="service-card" href="/limpieza-pc-gamer-floresta.html"><span class="card-number">02</span><h3>Limpieza<br />y mantenimiento</h3><p>Menos temperatura, más vida útil y rendimiento real.</p><span class="card-link">Conocer más →</span></a><a class="service-card" href="/optimizacion-pc-lenta-floresta.html"><span class="card-number">03</span><h3>Optimización<br />y upgrades</h3><p>Hacemos que tu equipo rinda mejor sin gastar de más.</p><span class="card-link">Conocer más →</span></a></div></section>
    <section class="process section"><div class="process-head"><p class="eyebrow">Así trabajamos</p><h2>Claro desde<br /><em>el minuto uno.</em></h2></div><div class="steps"><div><span>01</span><h3>Nos contás</h3><p>Qué pasa, cuándo empezó y qué necesitás lograr.</p></div><div><span>02</span><h3>Lo revisamos</h3><p>Diagnóstico real, explicado en lenguaje humano.</p></div><div><span>03</span><h3>Vos decidís</h3><p>Presupuesto claro. Reparamos solo con tu aprobación.</p></div></div></section>
    <section class="local section"><div><p class="eyebrow">Estamos cerca</p><h2>Un taller de barrio.<br /><em>Una atención enorme.</em></h2><p>Campana 51, Floresta. Vení con tu equipo o escribinos por WhatsApp para contarnos qué necesitás.</p><div class="hero-actions"><a class="btn btn-dark" href="/turnos.html">Quiero reservar <span>→</span></a><a class="under-link" href="/ubicacion.html">Cómo llegar</a></div></div><div class="local-card"><span class="pin">+</span><strong>Campana 51</strong><small>Floresta · CABA</small><a href="https://wa.me/5491135708345">Escribir por WhatsApp ↗</a></div></section>
    <section class="final-cta"><p class="eyebrow">¿Qué le pasa a tu equipo?</p><h2>Arranquemos por<br /><em>una charla.</em></h2><a class="btn btn-orange" href="/turnos.html">Reservar mi turno <span>→</span></a></section>
  </main><footer><span>PCLAF — Servicio técnico que responde.</span><span>Floresta, CABA</span><a href="https://wa.me/5491135708345">WhatsApp ↗</a></footer>
</SiteLayout>
<style>
main{overflow:hidden}.hero,.section{max-width:1240px;margin:auto;padding-left:clamp(24px,5vw,76px);padding-right:clamp(24px,5vw,76px)}.hero{min-height:650px;padding-top:78px;padding-bottom:72px;display:grid;grid-template-columns:1fr .92fr;align-items:center;gap:7vw}.eyebrow{font:500 11px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--orange)}.live-dot{display:inline-block;width:7px;height:7px;margin-right:9px;border-radius:50%;background:var(--green);box-shadow:0 0 0 4px #94d39a40}.hero h1{font-size:clamp(56px,8vw,112px);line-height:.92;letter-spacing:-.08em;margin:25px 0 30px;font-weight:800}.hero h1 em,h2 em{font-style:normal;color:var(--orange)}.hero-text{max-width:450px;color:var(--muted);font-size:18px;line-height:1.55}.hero-actions{display:flex;align-items:center;gap:28px;margin-top:35px}.btn{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;padding:16px 19px;text-decoration:none;font-size:12px;font-weight:800;border-radius:5px;transition:.25s}.btn-dark{background:var(--ink);color:var(--paper)}.btn-dark:hover,.btn-orange:hover{transform:translateY(-3px)}.btn-orange{background:var(--orange);color:var(--ink)}.btn span{font-size:20px}.under-link{text-decoration:none;border-bottom:1px solid var(--ink);padding-bottom:5px;font-size:12px;font-weight:700}.trust-row{display:flex;gap:20px;margin-top:52px;font:500 10px 'DM Mono',monospace;color:var(--muted);flex-wrap:wrap}.trust-row b{color:var(--orange);font-size:15px;margin-right:5px}.hero-image{position:relative}.hero-image img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;filter:saturate(.75);border-radius:7px}.image-note{position:absolute;bottom:20px;left:-24px;background:var(--ink);color:var(--paper);padding:16px 18px;display:grid;grid-template-columns:auto 1fr;column-gap:10px;align-items:center;box-shadow:8px 8px 0 var(--orange)}.image-note .live-dot{grid-row:span 2}.image-note strong{font:500 10px 'DM Mono',monospace}.image-note small{color:#aaa;font-size:11px;margin-top:5px}.ticker{padding:19px max(24px,5vw);background:var(--ink);color:var(--paper);display:flex;justify-content:space-around;align-items:center;gap:18px;font:500 11px 'DM Mono',monospace;letter-spacing:.1em}.ticker i{color:var(--orange);font-style:normal}.section{padding-top:125px;padding-bottom:125px}.section-intro{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:end}.section-intro h2,.process h2,.local h2{font-size:clamp(42px,5vw,70px);line-height:1;letter-spacing:-.07em;margin:18px 0 0}.section-intro>p:last-child{max-width:390px;line-height:1.6;color:var(--muted);margin:0}.service-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:13px;margin-top:65px}.service-card{min-height:330px;padding:25px;background:#e7e3da;text-decoration:none;display:flex;flex-direction:column;transition:transform .25s,background .25s}.service-card:hover{transform:translateY(-8px);background:var(--ink);color:var(--paper)}.service-card.featured{background:var(--orange)}.service-card.featured:hover{background:var(--ink)}.card-number{font:500 11px 'DM Mono',monospace;color:var(--muted)}.featured .card-number{color:var(--ink)}.service-card h3{font-size:29px;line-height:1.02;letter-spacing:-.05em;margin:60px 0 15px}.service-card p{color:var(--muted);font-size:13px;line-height:1.5;max-width:240px}.card-link{margin-top:auto;font:500 11px 'DM Mono',monospace}.process{background:var(--ink);color:var(--paper);max-width:none;padding-left:max(24px,calc((100% - 1088px)/2));padding-right:max(24px,calc((100% - 1088px)/2));display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.process .eyebrow{color:var(--orange)}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;padding-top:20px}.steps div{border-top:1px solid #494740;padding-top:18px}.steps span{font:500 11px 'DM Mono',monospace;color:var(--orange)}.steps h3{font-size:21px;margin:50px 0 12px}.steps p{color:#aaa;font-size:13px;line-height:1.5}.local{display:grid;grid-template-columns:1fr .8fr;gap:100px;align-items:center}.local>div>p:not(.eyebrow){max-width:400px;line-height:1.6;color:var(--muted);margin-top:28px}.local-card{background:#e7e3da;padding:35px;display:flex;flex-direction:column;gap:10px}.pin{width:42px;height:42px;display:grid;place-items:center;background:var(--orange);font-size:25px;border-radius:50%;margin-bottom:20px}.local-card strong{font-size:25px}.local-card small{color:var(--muted)}.local-card a{margin-top:32px;font:500 11px 'DM Mono',monospace;color:var(--orange);text-decoration:none}.final-cta{padding:120px 24px;text-align:center;background:var(--orange)}.final-cta h2{font-size:clamp(54px,8vw,104px);line-height:.9;letter-spacing:-.08em;margin:20px 0 40px}.final-cta h2 em{color:var(--ink)}footer{background:var(--ink);color:var(--paper);display:flex;justify-content:space-between;gap:20px;padding:28px max(24px,5vw);font:500 10px 'DM Mono',monospace}footer a{color:var(--orange);text-decoration:none}@media(max-width:760px){.hero{display:flex;flex-direction:column;align-items:stretch;gap:45px;padding-top:55px}.hero h1{font-size:62px}.hero-image{width:88%;margin-left:auto}.image-note{left:-15px}.ticker{overflow:hidden;justify-content:flex-start;white-space:nowrap}.ticker span:nth-of-type(n+4),.ticker i:nth-of-type(n+4){display:none}.section{padding-top:80px;padding-bottom:80px}.section-intro,.local,.process{display:flex;flex-direction:column;gap:35px}.service-grid{display:flex;flex-direction:column;margin-top:40px}.service-card{min-height:280px}.service-card h3{margin-top:45px}.steps{display:flex;flex-direction:column;gap:32px;width:100%}.steps h3{margin-top:25px}.local{gap:45px}.final-cta{padding:90px 24px}footer{flex-direction:column;gap:12px}}
</style>
