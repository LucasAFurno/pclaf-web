green)!important}.gamer-zone{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:10vw;padding:100px 7vw;background:#0d1b12;border-top:1px solid #284d31;border-bottom:1px solid #284d31}.gamer-zone h2 em{color:var(--t-green)}.gamer-zone p,.contact-copy p{max-width:430px;color:#aab8ad;line-height:1.6}.fps-display{padding:50px;border:1px solid #407442;background:#0b150e;text-align:center}.fps-display small,.fps-display span{display:block;color:var(--t-green);font:10px var(--t-mono);letter-spacing:.13em}.fps-display strong{display:block;font-size:150px;line-height:1;color:var(--t-green);text-shadow:0 0 35px #9cff5766}.fps-bars{display:flex;gap:5px;align-items:end;height:50px;justify-content:center}.fps-bars i{width:10px;background:var(--t-green);animation:bars 1s infinite alternate}.fps-bars i:nth-child(2){height:30px}.fps-bars i:nth-child(3){height:48px}.fps-bars i:nth-child(4){height:22px}.fps-bars i:nth-child(5){height:40px}.fps-bars i:nth-child(6){height:34px}.fps-bars i:nth-child(7){height:50px}.how-it-works{background:#0b0d0e}.protocol-list{grid-column:2;border-top:1px solid var(--t-line)}.protocol-list div{display:grid;grid-template-columns:60px 1fr 1fr;gap:15px;padding:24px 0;border-bottom:1px solid var(--t-line)}.protocol-list b{color:var(--t-red);font:12px var(--t-mono)}.protocol-list span{color:var(--t-muted);font-size:13px}.lab-contact{display:grid;grid-template-columns:1fr 1fr;min-height:530px;border-top:1px solid var(--t-line)}.contact-screen{padding:60px 7vw;display:flex;flex-direction:column;justify-content:space-between;background:repeating-linear-gradient(0deg,#0b0e0f 0,#0b0e0f 3px,#0d1112 4px);border-right:1px solid var(--t-line)}.contact-screen span,.contact-screen small{color:var(--t-green);font:10px var(--t-mono);letter-spacing:.14em}.contact-screen strong{font-size:clamp(36px,5vw,72px);line-height:.9}.contact-screen em{color:var(--t-red);font-style:normal}.contact-screen a,.whatsapp-link{color:var(--t-red);font:11px var(--t-mono);text-decoration:none}.contact-copy{padding:80px 7vw}.contact-copy h2{margin-top:30px}.whatsapp-link{display:block;margin-top:20px;color:var(--t-muted)}.techno-footer{border-top:1px solid var(--t-line);border-bottom:0}.techno-footer a{color:var(--t-red);text-decoration:none}@keyframes rotate{to{transform:rotate(360deg)}}@keyframes bootScan{from{transform:translateY(-18px)}to{transform:translateY(18px)}}@keyframes cursorBlink{0%,45%{opacity:1}46%,100%{opacity:0}}.boot-panel h1{animation:heroEnter .8s both}.boot-kicker{animation:heroEnter .5s .15s both}.boot-stats{animation:heroEnter .7s .3s both}.boot-log{animation:heroEnter .8s .55s both}@keyframes heroEnter{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}@keyframes pulse{50%{opacity:.3}}@keyframes bars{to{opacity:.35;transform:scaleY(.5)}}@keyframes slide{to{transform:translateX(-10%)}}@media(max-width:800px){.system-bar span:last-child{display:none}.command-hero,.gamer-zone,.lab-contact{grid-template-columns:1fr}.hero-terminal{padding:70px 7vw;border-right:0}.hero-console{min-height:440px}.console-ring{width:280px}.console-readout{bottom:35px}.notice-line{margin:16px;align-items:flex-start;flex-wrap:wrap}.notice-line span{flex-basis:100%;order:3}.modules,.how-it-works{grid-template-columns:1fr;padding:80px 7vw;gap:50px}.module-grid{grid-template-columns:1fr}.protocol-list{grid-column:auto}.protocol-list div{grid-template-columns:45px 1fr}.protocol-list span{grid-column:2}.fps-display{padding:35px}.contact-screen{min-height:350px;border-right:0}.contact-copy{padding:70px 7vw}.techno-footer{flex-wrap:wrap;gap:15px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
