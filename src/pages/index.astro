mage img,.media-wall img{width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.2)}.photo-tag,.photo-coord{position:absolute;padding:10px;color:var(--white);background:#08090ad9;font:9px var(--mono)}.photo-tag{top:25px;left:25px}.photo-coord{bottom:25px;right:25px}.matrix,.symptoms,.recovery,.process,.tracking,.business,.faq{padding:110px 8vw;border-bottom:1px solid var(--line)}.matrix{display:grid;grid-template-columns:.8fr 1.2fr;gap:10vw}.section-lead h2,.symptom-title h2{font-size:clamp(45px,6vw,82px)}.section-lead p,.thermal-copy p,.recovery p,.about p,.location p{color:var(--muted);line-height:1.6}.service-index{border-top:1px solid var(--line)}details{border-bottom:1px solid var(--line)}summary{cursor:pointer;list-style:none;padding:22px 0;font:13px var(--mono);display:flex;gap:20px}summary b{color:var(--red)}summary span{margin-left:auto;color:var(--red)}details p{color:var(--muted);font:12px/1.6 var(--mono);padding:0 0 22px 45px}.symptoms{display:grid;grid-template-columns:.8fr 1.2fr;gap:10vw;background:#0e1011}.symptom-list{display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid var(--line)}.symptom-list button{background:none;color:var(--white);border:0;border-bottom:1px solid var(--line);padding:21px 0;text-align:left;font:12px var(--mono);cursor:pointer}.symptom-list button:hover{color:var(--red)}output{grid-column:1/-1;padding:24px 0;color:var(--red);font:11px var(--mono)}.thermal{display:grid;grid-template-columns:1.25fr .75fr;min-height:610px}.thermal-image{min-height:500px}.thermal-copy{padding:10vw 6vw;background:#15191a;display:flex;flex-direction:column;justify-content:center}.thermal-copy h2{font-size:clamp(48px,6vw,80px)}.temp-readout{border-top:1px solid var(--line);margin-top:35px;padding-top:20px;display:flex;gap:15px;align-items:center}.temp-readout b{font:54px var(--mono);color:var(--red)}.temp-readout span{font:9px var(--mono);color:var(--muted)}.gamer{display:grid;grid-template-columns:1fr 1fr;gap:10vw;padding:130px 12vw;background:#0d160f;color:var(--white)}.gamer small,.benchmark span{color:var(--green);font:10px var(--mono)}.gamer h2{font-size:clamp(70px,9vw,130px)}.gamer p{max-width:380px;color:#aab7aa;line-height:1.6}.benchmark{align-self:center;border:1px solid #335a36;padding:35px;background:#111d14;box-shadow:0 0 50px #9cff5715}.benchmark>b{display:block;font:120px var(--mono);color:var(--green);line-height:1}.benchmark>small{display:block}.bars{display:flex;align-items:end;height:80px;gap:7px;border-bottom:1px solid #335a36;margin:25px 0}.bars i{flex:1;background:var(--green);height:40%;animation:bar 1s infinite alternate}.bars i:nth-child(2n){height:80%;animation-delay:.2s}.bars i:nth-child(3n){height:60%;animation-delay:.4s}dl{display:grid;grid-template-columns:1fr 1fr;gap:12px;font:10px var(--mono)}dl div{display:flex;justify-content:space-between}dd{margin:0;color:var(--green)}.motherboard{display:grid;grid-template-columns:1fr 1fr;min-height:570px;border-bottom:1px solid var(--line)}.mother-copy{padding:11vw 9vw}.mother-copy h2{font-size:clamp(55px,7vw,95px)}.pcb-lines{position:relative;background:linear-gradient(135deg,#17191b,#08090a);overflow:hidden}.pcb-lines:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent 49%,#f0222b88 50%,transparent 51%),linear-gradient(0deg,transparent 49%,#f0222b44 50%,transparent 51%);background-size:90px 90px;animation:grid 5s linear infinite}.pcb-lines span{position:absolute;border:1px solid var(--red);width:160px;height:160px;border-radius:50%;animation:pcb 4s infinite}.pcb-lines span:nth-child(1){left:20%;top:25%}.pcb-lines span:nth-child(2){right:15%;bottom:20%;width:90px;height:90px;animation-delay:1s}.pcb-lines b{position:absolute;right:12%;top:12%;font:10px var(--mono);color:var(--red)}.recovery{display:grid;grid-template-columns:1fr 1fr;gap:10vw;align-items:center}.recovery-terminal{position:relative;overflow:hidden}.matrix-terminal{background:#0b1210;border-left:2px solid var(--r