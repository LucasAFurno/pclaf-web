---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="PCLAF | Servicio técnico, diseño web y PCLAFControl" description="Servicio técnico de PC y notebook en Floresta, Flores y CABA. Diagnóstico, reparación, limpieza Gamer, upgrades y diseño web." canonical="/">
<main class="lab-home">
<header class="topline"><a href="/" class="brand">PCLAF <i></i><small>// TECH LAB</small></a><span><b></b> SYSTEM ONLINE</span><nav><a href="#servicios">Servicios</a><a href="#proceso">Proceso</a><a href="/turnos.html">Turnos ↗</a></nav></header>
<section class="hero"><div class="hero-copy"><small class="eyebrow">PCLAF LAB / 01</small><h1>Tu PC.<br /><em>Sin límites.</em></h1><p>Diagnóstico, reparación y upgrades para que tu equipo vuelva a rendir como tiene que rendir.</p><div class="actions"><a class="button red" href="/turnos.html">Solicitar diagnóstico ↗</a><a class="button line" href="#servicios">Ver servicios ↗</a></div><div class="hero-meta">FLORESTA // CABA <span>ATENCIÓN CON TURNO PREVIO</span></div></div><div class="hero-photo"><img src="/images/pclaf-hardware.png" alt="Técnico trabajando sobre una motherboard" /><span class="photo-tag">HARDWARE / REPAIR</span><span class="photo-coord">-34.6153, -58.4910</span></div></section>
<section class="matrix" id="servicios"><div class="section-lead"><small>// SERVICE INDEX</small><h2>Soluciones reales<br />para problemas <em>reales.</em></h2><p>Un índice claro para encontrar el servicio que necesitás.</p></div><div class="service-index"><details open><summary><b>01</b> DIAGNÓSTICO <span>+</span></summary><p>Revisión general · Revisión y diagnóstico sin cargo · Otro / no sé qué tiene</p></details><details><summary><b>02</b> SISTEMA <span>+</span></summary><p>Formateo Windows 10 / 11 · Drivers · Software esencial · Optimización</p></details><details><summary><b>03</b> THERMAL <span>+</span></summary><p>Limpieza interna PC y notebook · Cambio de pasta térmica · Ventilación</p></details><details><summary><b>04</b> HARDWARE <span>+</span></summary><p>Service PC · Service notebook · Reparación motherboard PC y notebook</p></details><details><summary><b>05</b> GPU / GAMER <span>+</span></summary><p>Limpieza GPU · Performance gamer · Temperaturas · Airflow · Estabilidad</p></details><details><summary><b>06</b> BACKUP / REMOTE <span>+</span></summary><p>Backup de archivos · Atención remota · Soporte y seguimiento</p></details></div></section>
<section class="symptoms"><div class="symptom-title"><small>// DIAGNOSTIC SELECTOR</small><h2>¿Qué está<br /><em>fallando?</em></h2></div><div class="symptom-list"><button data-detail="Revisión de fuente, motherboard y componentes.">NO ENCIENDE</button><button data-detail="Optimización, limpieza y upgrades con sentido.">VA LENTA</button><button data-detail="Limpieza interna, ventilación y pasta térmica.">SE CALIENTA</button><button data-detail="Diagnóstico de energía y temperatura.">SE APAGA</button><button data-detail="Formateo, drivers y corrección de errores.">WINDOWS FALLA</button><button data-detail="Revisión de cooler, ventiladores y GPU.">HACE RUIDO</button><button data-detail="Diagnóstico de placa, GPU y conexión.">NO DA IMAGEN</button><button data-detail="Optimización de sistema y hardware.">PERDIÓ RENDIMIENTO</button><output id="symptom-detail">Elegí un síntoma para ver por dónde empezar.</output></div></section>
<section class="thermal"><div class="thermal-image"><img src="/images/pclaf-hardware.png" alt="Detalle de motherboard y componentes durante una reparación" /></div><div class="thermal-copy"><small>THERMAL_LAB // ACTIVE</small><h2>Menos calor.<br /><em>Más estabilidad.</em></h2><p>Limpieza interna, ventilación y cambio de pasta térmica según el estado real de tu equipo. No prometemos una temperatura universal: medimos, explicamos y recomendamos.</p><div class="temp-readout"><b>24°</b><span>THERMAL CHECK<br />WITHIN RANGE</span></div></div></section>
<section class="gamer"><div><small>GAMER_MODE // ACTIVE</small><h2>Subí<br />el nivel.</h2><p>Limpieza PC Gamer, GPU, airflow, pasta térmica, drivers y optimización para ganar estabilidad.</p><a class="button green" href="/limpieza-pc-gamer-floresta.html">Optimizar mi setup ↗</a></div><div class="benchmark"><span>BENCHMARK / LIVE</span><b>144</b><small>FPS ESTABLE</small><div class="bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><dl><div><dt>CPU</dt><dd>42%</dd></div><div><dt>GPU</dt><dd>68%</dd></div><div><dt>TEMP</dt><dd>24°C</dd></div><div><dt>FRAME TIME</dt><dd>6.9ms</dd></div></dl></div></section>
<section class="motherboard"><div class="mother-copy"><small>HARDWARE / BOARD REPAIR</small><h2>No todo<br />se cambia.<br /><em>Se repara.</em></h2><p>Reparación de motherboard PC y notebook. Diagnóstico electrónico antes de decidir.</p><a class="button line" href="/diagnostico-pc-notebook-floresta.html">Consultar diagnóstico ↗</a></div><div class="pcb-lines"><span></span><span></span><span></span><b>BOARD // SIGNAL<br />ACTIVE</b></div></section>
<section class="recovery"><div class="recovery-terminal matrix-terminal" aria-label="Terminal PowerShell cargando el sistema"><div class="matrix-rain" aria-hidden="true">01010110 01101001 01110010 01110100 01110101 01100001 01101100<br />10101001 00110001 11001010 01010100 01100101 01100011 01101000<br />01110010 01100101 01100011 01101111 01110110 01100101 01110010</div><div class="powershell-bar"><span>PS</span> <span class="typed-command"></span><b class="typing-cursor">▌</b></div><div class="terminal-title">SYSTEM RECOVERY <i>●</i></div><div class="load-lines" aria-live="polite"></div><div class="load-track"><i></i></div><div class="load-footer"><span>BOOT SEQUENCE</span><b class="load-percent">0%</b></div><div class="terminal-cursor">▮</div></div><div><h2>Windows limpio.<br /><em>Sin basura.</em></h2><p>Windows 10 / 11, drivers, software esencial, optimización, corrección de errores y backup opcional.</p><a class="button line" href="/instalacion-windows-floresta.html">Ver instalación ↗</a></div></section>
<section class="backup"><small>BACKUP / CAPACITY</small><h2>Tus archivos<br /><em>importan.</em></h2><p>Podemos evaluar un backup previo a la intervención cuando corresponde.</p><div class="storage"><div><b>50 GB</b><span>BASE</span></div><div><b>100 GB</b><span>MEDIUM</span></div><div><b>200 GB</b><span>HIGH</span></div><div><b>+200 GB</b><span>A COTIZAR</span></div></div></section>
<section class="process" id="proceso"><div class="process-head"><small>// OUR PROCESS</small><h2>Sin humo.<br /><em>Con proceso.</em></h2></div><div class="pipeline"><div><b>01</b><strong>Pedís turno</strong><span>Elegís cuándo traer tu equipo.</span></div><i>→</i><div><b>02</b><strong>Diagnóstico</strong><span>Buscamos la falla real.</span></div><i>→</i><div><b>03</b><strong>Presupuesto</strong><span>Vos decidís antes de avanzar.</span></div><i>→</i><div><b>04</b><strong>Retirás</strong><span>Avisamos por WhatsApp.</span></div></div></section>
<section class="tracking"><div><small>TRACKING_SYSTEM // ONLINE</small><h2>¿Dejaste<br />tu equipo?</h2></div><div class="track-status"><span>INGRESADO</span><span>DIAGNÓSTICO</span><span>EN REPARACIÓN</span><span>LISTO</span></div><a class="button red" href="/historial.html">Ver mi equipo ↗</a></section>
<section class="numbers"><small>// NUMBERS THAT MATTER</small><div><strong>15+</strong><span>AÑOS DE EXPERIENCIA</span></div><div><strong>3200+</strong><span>EQUIPOS REPARADOS</span></div><div><strong>01</strong><span>LABORATORIO</span></div></section>
<section class="workshop"><div class="workshop-copy"><small>// THE WORKSHOP</small><h2>No te contamos<br />cómo trabajamos.<br /><em>Te lo mostramos.</em></h2><p>Contenido real del laboratorio y del trabajo técnico de PCLAF.</p><a href="https://www.instagram.com/servicepclaf" class="button line">@servicepclaf ↗</a></div><div class="media-wall"><img src="/images/pclaf-hardware.png" alt="Trabajo técnico en el laboratorio" /><div class="media-note">INSTAGRAM / TIKTOK<br /><b>REAL WORK</b></div></div></section>
<section class="about"><div><small>TEAM // PCLAF</small><h2>Personas reales.<br /><em>Soluciones reales.</em></h2><p>Más de 15 años trabajando con hardware y software. Atención directa, sin call center.</p></div><div class="team-list">LUCAS　 NOE　 MICA<br />DIEGO　 SANTI</div></section>
<section class="reviews"><small>REVIEW STREAM / GOOGLE</small><blockquote>��Desde el año 2022 que soy cliente de PCLAF y siempre recibimos una atención excelente, con diagnósticos justos y presupuestos acordes.”</blockquote><cite>NATALIA O. · GOOGLE MAPS</cite><a href="https://www.google.com/maps/search/PCLAF+Campana+51" class="button line">Ver reseñas en Google ↗</a></section>
<section class="business"><small>PCLAF TAMBIÉN HACE</small><h2>Del hardware<br /><em>al negocio.</em></h2><div class="business-grid"><article><span>01 / DISEÑO WEB</span><h3>Webs que hacen avanzar tu negocio.</h3><p>Mini Web, landing, sitio institucional y catálogo comercial.</p><a href="/diseno-web.html">Ver diseño web ↗</a></article><article><span>02 / PCLAFCONTROL</span><h3>Ordená clientes, trabajos y presupuestos.</h3><p>Una herramienta para organizar el seguimiento de tu operación.</p><a href="/pclaf-index.html">Conocer PCLAFControl ↗</a></article></div></section>
<section class="faq"><small>KNOWLEDGE_BASE</small><h2>Preguntas<br /><em>frecuentes.</em></h2><div><details><summary>FAQ_001　¿Cuánto tarda un formateo?</summary><p>Depende del equipo y del trabajo necesario. Lo confirmamos al diagnosticar.</p></details><details><summary>FAQ_002　¿Qué pasa con mis archivos?</summary><p>Evaluamos backup antes de formatear cuando corresponde.</p></details><details><summary>FAQ_003　¿Tiene garantía?</summary><p>Consultá las condiciones actuales antes de aprobar el trabajo.</p></details><details><summary>FAQ_004　¿Puedo seguir mi equipo?</summary><p>Sí, desde el historial online con tu código.</p></details></div></section>
<section class="location"><iframe title="Ubicación de PCLAF en Campana 51, Floresta" src="https://www.google.com/maps?q=Campana+51,+Floresta,+Buenos+Aires&output=embed" loading="lazy"></iframe><div><small>LOCATION // VISITA SOLO CON TURNO</small><h2>Campana 51.<br /><em>Floresta, CABA.</em></h2><p>Lunes a viernes · 10:00 a 19:00<br />11 3570-8345</p><a class="button line" href="/ubicacion.html">Ver ubicación ↗</a></div></section>
<section class="final-cta"><small>// READY TO SOLVE IT?</small><h2>Dejemos tu PC<br /><em>como tiene que ser.</em></h2><a class="button red" href="/turnos.html">Reservar mi turno ↗</a><a href="https://wa.me/5491135708345">Escribir por WhatsApp ↗</a></section>
<footer><div><b>PCLAF <i></i></b><small>// TECH LAB</small></div><nav><a href="#servicios">Servicios</a><a href="/diseno-web.html">Diseño web</a><a href="/historial.html">Seguimiento</a><a href="/precios.html">Precios</a><a href="/ubicacion.html">Ubicación</a></nav><div class="online"><i></i> SYSTEM STATUS<br /><small>CAMPANA 51 · FLORESTA<br />LUN—VIE 10—19</small></div></footer>
</main>
</SiteLayout>
<script>document.querySelectorAll('[data-detail]').forEach((button)=>button.addEventListener('click',()=>{document.querySelector('#symptom-detail').textContent=button.dataset.detail}));const terminal=document.querySelector('.matrix-terminal');if(terminal){const command=terminal.querySelector('.typed-command'),lines=terminal.querySelector('.load-lines'),percent=terminal.querySelector('.load-percent'),bar=terminal.querySelector('.load-track i'),steps=[['checking hardware','OK'],['loading drivers','OK'],['restoring windows','OK'],['applying updates','OK'],['optimizing system','READY']];let cancelled=false;const type=(el,text,speed)=>new Promise(resolve=>{let i=0;const tick=()=>{if(cancelled)return;el.textContent=text.slice(0,i++);if(i<=text.length)setTimeout(tick,speed);else resolve()};tick()});const boot=async()=>{command.textContent='';lines.innerHTML='';percent.textContent='0%';bar.style.width='0%';await new Promise(r=>setTimeout(r,650));await type(command,'C:\\PCLAF\\SYSTEM_RECOVERY',24);for(let i=0;i<steps.length;i++){await new Promise(r=>setTimeout(r,260));const row=document.createElement('p');row.innerHTML='&gt; '+steps[i][0]+' <b>'+steps[i][1]+'</b>';lines.appendChild(row);await type(row,'> '+steps[i][0]+' ',10);row.innerHTML='&gt; '+steps[i][0]+' <b>'+steps[i][1]+'</b>';const value=Math.round(((i+1)/steps.length)*100);bar.style.width=value+'%';percent.textContent=value+'%'}setTimeout(boot,2600)};boot()}</script>
<style>
