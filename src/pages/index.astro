;padding:0 12px;gap:12px;color:#9cff57;font:9px var(--t-mono);z-index:1}.board-gpu b{width:8px;height:28px;background:#9cff57;animation:gpuBars 1.1s infinite alternate}.board-gpu b:nth-of-type(2){height:17px;animation-delay:.2s}.board-gpu b:nth-of-type(3){height:23px;animation-delay:.4s}.board-ram{position:absolute;right:8%;top:17%;display:flex;gap:4px;align-items:flex-end;color:#9cff57;font:8px var(--t-mono);z-index:1}.board-ram i{width:6px;height:45px;background:#9cff57;box-shadow:0 0 8px #9cff57;animation:ramBlink 1.3s infinite alternate}.board-ram i:nth-of-type(2){height:31px;animation-delay:.2s}.board-ram i:nth-of-type(3){height:39px;animation-delay:.4s}.board-ram i:nth-of-type(4){height:24px;animation-delay:.6s}.board-fan{position:absolute;right:15%;bottom:33%;width:72px;height:72px;border:1px solid #f4f4f155;border-radius:50%;animation:fanSpin 2s linear infinite;z-index:1}.board-fan:before{content:'';position:absolute;inset:14px;border:1px dashed #9cff57;border-radius:50%}.board-fan i{position:absolute;left:34px;top:7px;width:5px;height:29px;background:#9cff5777;transform-origin:3px 29px}.board-fan i:nth-child(2){transform:rotate(60deg)}.board-fan i:nth-child(3){transform:rotate(120deg)}.board-fan i:nth-child(4){transform:rotate(180deg)}.board-fan i:nth-child(5){transform:rotate(240deg)}.board-fan i:nth-child(6){transform:rotate(300deg)}.board-port{position:absolute;width:28px;height:7px;border:1px solid #f0222b;right:4%;bottom:13%}.port-two{bottom:8%;width:45px}.board-scan{position:absolute;left:15px;bottom:12px;color:#9cff57;font:8px var(--t-mono);z-index:2}.board-scan strong{color:#fff;margin-left:8px}.console-ring{display:none}.pc-board~.console-readout{margin-top:30px}@keyframes boardFloat{0%,100%{transform:perspective(800px) rotateX(8deg) rotateY(-12deg) translateY(0)}50%{transform:perspective(800px) rotateX(8deg) rotateY(-12deg) translateY(-12px)}}@keyframes gridShift{from{background-position:0 0}to{background-position:24px 24px}}@keyframes gpuBars{to{