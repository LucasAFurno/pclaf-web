---
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/Navigation.astro';
---
<SiteLayout title="Servicio técnico de PC y notebook en Floresta | PCLAF" description="Reparamos PC, notebooks y equipos Gamer en Floresta, Flores y CABA. Diagnóstico, mantenimiento y upgrades con turno previo." canonical="/">
  <Navigation />
  <main>
    <div class="top-alert"><span>●</span><strong>LABORATORIO CERRADO · ATENCIÓN CON TURNO PREVIO</strong><a href="/turnos.html">Reservar ahora ↗</a></div>
    <section class="new-hero"><div class="hero-copy"><p class="kicker">PCLAF / TECH SERVICE / CABA</p><h1>Reparamos<br /><em>lo que importa.</em></h1><p class="lead">Tu PC, notebook o setup Gamer merece una solución, no una suposición. Diagnóstico técnico, presupuesto claro y atención directa en Floresta.</p><div class="hero-actions"><a class="primary-btn" href="/turnos.html">Quiero reparar mi equipo <span>↗</span></a><a class="secondary-btn" href="/historial.html">Consultar mi arreglo</a></div><div class="hero-facts"><div><b>01</b><span>Diagnóstico real</span></div><div><b>02</b><span>Presupuesto previo</span></div><div><b>03</b><span>Seguimiento directo</span></div></div></div><div class="hero-media"><img src="/images/pclaf-hardware.png" alt="Técnico reparando hardware en el laboratorio PCLAF" /><div class="media-overlay"><span>HARDWARE LAB</span><strong>PRECISIÓN<br />SIN VUELTAS</strong></div><div class="media-index">PCLAF<br /><small>01 — 04</small></div></div></section>
    <section class="ticker" aria-label="Especialidades"><div>PC QUE NO ENCIENDE <i>✦</i> NOTEBOOKS <i>✦</i> WINDOWS <i>✦</i> TEMPERATURA <i>✦</i> GAMER <i>✦</i> UPGRADES <i>✦</i></div></section>
    <section class="intro-block"><p class="kicker">No somos un local a la calle</p><div><h2>Somos el laboratorio<br /><em>detrás del arreglo.</em></h2><p>Trabajamos con turno previo en un espacio dedicado. Eso nos permite concentrarnos en cada equipo, documentar el proceso y darte una respuesta honesta.</p><a class="under-link" href="/ubicacion.html">Conocer ubicación y modalidad ↗</a></div></section>
    <section class="service-showcase" id="servicios"><div class="section-lead"><p class="kicker">Qué podemos resolver</p><h2>Un problema.<br /><em>Una solución.</em></h2><p>Elegí el camino según lo que le pasa a tu equipo.</p></div><div class="service-stack"><a href="/diagnostico-pc-notebook-floresta.html" class="service-row"><span>01</span><div><small>PC / NOTEBOOK</small><h3>No enciende, falla o se apaga</h3><p>Diagnóstico y reparación de hardware.</p></div><b>↗</b></a><a href="/optimizacion-pc-lenta-floresta.html" class="service-row"><span>02</span><div><small>RENDIMIENTO</small><h3>Está lenta y te hace perder tiempo</h3><p>Optimización, limpieza y upgrades inteligentes.</p></div><b>↗</b></a><a href="/cambio-pasta-termica-notebook-caba.html" class="service-row"><span>03</span><div><small>TEMPERATURA</small><h3>Se calienta demasiado</h3><p>Pasta térmica, ventilación y mantenimiento interno.</p></div><b>↗</b></a><a href="/limpieza-pc-gamer-floresta.html" class="service-row gamer-row"><span>04</span><div><small>GAMER / PERFORMANCE</small><h3>Tu setup no rinde como antes</h3><p>Limpieza profunda y puesta a punto Gamer.</p></div><b>↗</b></a></div></section>
    <section class="gamer-feature"><div><p class="kicker">Zona Gamer</p><h2>Más FPS.<br /><em>Menos temperatura.</em></h2><p>Optimizamos tu PC Gamer para que juegues con estabilidad, mejor flujo de aire y componentes cuidados.</p><a class="gamer-btn" href="/limpieza-pc-gamer-floresta.html">Potenciar mi setup ↗</a></div><div class="gamer-meter"><span>PERFORMANCE CHECK</span><strong>98<span>%</span></strong><small>THERMAL BALANCE / READY</small></div></section>
    <section class="steps"><div class="steps-heading"><p class="kicker">Cómo trabajamos</p><h2>Claro desde<br /><em>el primer mensaje.</em></h2></div><div class="steps-grid"><article><b>01</b><h3>Reservás</h3><p>Elegís día y horario. Te confirmamos la recepción.</p></article><article><b>02</b><h3>Diagnosticamos</h3><p>Buscamos la causa real y te explicamos qué encontramos.</p></article><article><b>03</b><h3>Decidís</h3><p>Aprobás el presupuesto. Recién ahí reparamos.</p></article></div></section>
    <section class="contact-band" id="contacto"><div class="contact-map"><span>LABORATORIO PCLAF</span><strong>Campana 51<br />Floresta, CABA</strong><i>+</i></div><div class="contact-info"><p class="kicker">Coordiná tu visita</p><h2>No vengas<br /><em>sin turno.</em></h2><p>Atendemos únicamente con reserva previa. Escribinos por WhatsApp o elegí un horario desde la agenda.</p><div class="contact-actions"><a class="primary-btn" href="/turnos.html">Sacar turno ↗</a><a class="under-link" href="https://wa.me/5491135708345">WhatsApp · 11 3570-8345</a></div></div></section>
    <section class="closing"><p class="kicker">Tu equipo tiene arreglo</p><h2>Hacé que vuelva<br /><em>a funcionar.</em></h2><a class="primary-btn" href="/turnos.html">Reservar turno <span>↗</span></a></section>
  </main><footer><span>PCLAF / TECH SERVICE</span><span>Campana 51 · Floresta, CABA</span><a href="/historial.html">Consultar mi arreglo ↗</a></footer>
</SiteLayout>
<style>
:global(:root){--black:#080808;--white:#f4f2ed;--red:#e21b23;--muted:#999;--line:#292929;--green:#87e36d}main{background:var(--black);overflow:hidden}.top-alert{max-width:1280px;margin:96px auto 0;padding:13px 24px;display:flex;align-items:center;gap:12px;border:1px solid #6f5200;background:#171106;color:#f6d47b;font:11px var(--mono);letter-spacing:.05em}.top-alert span{color:#ffc400;animation:blink 1.4s infinite}.top-alert strong{flex:1}.top-alert a{color:#ffc400;text-decoration:none;border-bottom:1px solid #ffc400;padding-bottom:3px}.new-hero{max-width:1280px;min-height:700px;margin:auto;padding:70px 6vw 92px;display:grid;grid-template-columns:1fr 1fr;gap:7vw;align-items:center}.kicker{color:var(--red);font:500 11px var(--mono);letter-spacing:.12em;text-transform:uppercase}.hero-copy h1,.intro-block h2,.section-lead h2,.gamer-feature h2,.steps-heading h2,.contact-info h2,.closing h2{font-size:clamp(54px,7vw,102px);line-height:.88;letter-spacing:-.07em;margin:28px 0}.hero-copy h1 em,.intro-block em,.section-lead em,.steps-heading em,.contact-info em,.closing em{color:var(--red);font-style:normal}.lead{max-width:500px;color:#bdbdbd;font-size:17px;line-height:1.6}.hero-actions{display:flex;flex-wrap:wrap;gap:14px;margin:35px 0}.primary-btn,.secondary-btn,.gamer-btn{display:inline-flex;align-items:center;gap:18px;padding:17px 20px;text-decoration:none;font:700 12px var(--mono);transition:transform .25s,background .25s}.primary-btn{background:var(--red);color:#fff}.primary-btn:hover{background:#fff;color:var(--black);transform:translateY(-4px)}.secondary-btn{border:1px solid var(--line);color:#fff}.secondary-btn:hover{border-color:var(--red);transform:translateY(-4px)}.hero-facts{display:flex;gap:25px;border-top:1px solid var(--line);padding-top:18px}.hero-facts div{display:flex;flex-direction:column;gap:6px}.hero-facts b{color:var(--red);font:11px var(--mono)}.hero-facts span{font-size:11px;color:var(--muted)}.hero-media{height:590px;position:relative;overflow:hidden;background:#181818}.hero-media:after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 55%,#e21b2333);pointer-events:none}.hero-media img{width:100%;height:100%;object-fit:cover;filter:grayscale(.8) contrast(1.1);transform:scale(1.04);animation:slowZoom 10s ease-in-out infinite alternate}.media-overlay,.media-index{position:absolute;z-index:2}.media-overlay{left:25px;bottom:24px}.media-overlay span,.media-index{font:10px var(--mono);color:#fff}.media-overlay strong{display:block;margin-top:12px;font-size:27px;line-height:.95}.media-index{right:22px;top:22px;color:var(--red);text-align:right;font-size:18px}.media-index small{color:#fff;font-size:10px}.ticker{border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden;white-space:nowrap;color:#777;font:700 13px var(--mono);padding:19px 0}.ticker div{display:inline-block;animation:marquee 24s linear infinite}.ticker i{color:var(--red);font-style:normal;padding:0 28px}.intro-block,.service-showcase,.steps,.contact-band{max-width:1280px;margin:auto;padding:130px 6vw;display:grid;grid-template-columns:.7fr 1.3fr;gap:10vw}.intro-block h2,.section-lead h2,.steps-heading h2,.contact-info h2{font-size:clamp(48px,5vw,76px)}.intro-block div>p,.section-lead>p:last-child,.contact-info>p{max-width:470px;color:var(--muted);line-height:1.7}.under-link{display:inline-block;margin-top:22px;color:#fff;text-decoration:none;border-bottom:1px solid var(--red);padding-bottom:6px;font-size:12px}.service-stack{border-top:1px solid var(--line)}.service-row{display:grid;grid-template-columns:55px 1fr 25px;gap:15px;align-items:center;padding:22px 0;border-bottom:1px solid var(--line);color:#fff;text-decoration:none;transition:padding .3s,background .3s}.service-row:hover{padding-left:15px;background:#111}.service-row>span{color:var(--red);font:12px var(--mono)}.service-row small{color:#777;font:10px var(--mono)}.service-row h3{font-size:22px;margin:8px 0}.service-row p{color:#888;margin:0;font-size:13px}.service-row>b{color:var(--red);font-size:23px}.gamer-row{color:#dfffd8}.gamer-row>span,.gamer-row b,.gamer-row small{color:var(--green)}.gamer-feature{max-width:1150px;margin:0 auto 130px;padding:70px;display:flex;align-items:center;justify-content:space-between;gap:40px;background:#0d2115;border:1px solid #266536;position:relative;overflow:hidden}.gamer-feature h2{font-size:clamp(48px,6vw,82px)}.gamer-feature h2 em{color:var(--green);font-style:normal}.gamer-feature p{max-width:430px;color:#a6c2aa;line-height:1.6}.gamer-btn{margin-top:22px;background:var(--green);color:#071008}.gamer-meter{width:250px;height:250px;flex:none;border:1px solid #54ad6a;border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;animation:float 4s ease-in-out infinite}.gamer-meter span,.gamer-meter small{font:10px var(--mono);color:var(--green)}.gamer-meter strong{font-size:75px;line-height:1}.gamer-meter strong span{font-size:24px}.steps{background:#101010;max-width:none;padding-left:calc((100% - 1150px)/2);padding-right:calc((100% - 1150px)/2)}.steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}.steps-grid article{background:#101010;padding:25px;min-height:210px;transition:transform .25s}.steps-grid article:hover{transform:translateY(-8px)}.steps-grid b{color:var(--red);font:12px var(--mono)}.steps-grid h3{margin-top:60px;font-size:22px}.steps-grid p{color:#888;line-height:1.55;font-size:13px}.contact-band{align-items:center}.contact-map{height:390px;background:#161616;display:flex;flex-direction:column;justify-content:space-between;padding:25px;position:relative;background-image:linear-gradient(25deg,transparent 48%,#272727 49%,transparent 50%),linear-gradient(90deg,transparent 48%,#272727 49%,transparent 50%);background-size:100px 100px}.contact-map span{font:10px var(--mono);color:var(--red)}.contact-map strong{font-size:34px;line-height:.95}.contact-map i{position:absolute;left:50%;top:47%;width:55px;height:55px;border:1px solid var(--red);border-radius:50%;display:grid;place-items:center;color:var(--red);font-style:normal;font-size:30px;animation:ping 2s infinite}.contact-actions{display:flex;flex-direction:column;align-items:flex-start}.closing{text-align:center;padding:150px 24px;background:var(--red);color:#fff}.closing .kicker{color:#fff}.closing em{color:#080808}.closing .primary-btn{background:#080808;margin-top:15px}.closing .primary-btn:hover{background:#fff;color:#080808}footer{max-width:1280px;margin:auto;padding:25px 6vw;display:flex;justify-content:space-between;gap:20px;color:#777;font:10px var(--mono)}footer a{color:var(--red);text-decoration:none}@keyframes blink{50%{opacity:.35}}@keyframes slowZoom{to{transform:scale(1.13)}}@keyframes marquee{to{transform:translateX(-50%)}}@keyframes float{50%{transform:translateY(-12px) rotate(3deg)}}@keyframes ping{50%{box-shadow:0 0 0 16px transparent}}@media(max-width:800px){.top-alert{margin:88px 16px 0;align-items:flex-start;flex-wrap:wrap}.top-alert strong{flex-basis:calc(100% - 28px);line-height:1.5}.top-alert a{margin-left:28px}.new-hero,.intro-block,.service-showcase,.steps,.contact-band{display:flex;flex-direction:column;padding:80px 24px;gap:45px}.new-hero{padding-top:60px}.hero-media{height:390px;width:100%}.hero-facts{gap:13px;flex-wrap:wrap}.hero-facts span{font-size:10px}.service-row{grid-template-columns:35px 1fr 20px}.service-row h3{font-size:18px}.gamer-feature{margin:0 16px 80px;padding:40px 25px;display:block}.gamer-meter{width:190px;height:190px;margin:40px auto 0}.gamer-meter strong{font-size:55px}.steps{padding-left:24px;padding-right:24px}.steps-grid{grid-template-columns:1fr}.steps-grid article{min-height:150px}.steps-grid h3{margin-top:30px}.contact-map{width:100%;height:300px}.closing{padding:100px 24px}footer{padding:24px;flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
</style>
<style is:global>
html{background:#080808}body{margin:0;background:#080808;color:#f4f2ed;font-family:Arial,sans-serif}*{box-sizing:border-box}
</style>
