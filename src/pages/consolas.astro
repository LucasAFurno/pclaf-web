---
import SiteLayout from '../layouts/SiteLayout.astro';
import { consoles } from '../data/consoles';
---
<SiteLayout title="Service de consolas en Floresta | PCLAF" description="Elegí tu PlayStation o Xbox y consultá el precio del service preventivo en PCLAF.">
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/pclaf-nav.css" />
    <script src="/assets/pclaf-nav.js" defer></script>
  </Fragment>
  <div class="hub console-main"><nav class="legacy-nav"><a class="nav-logo" href="/index.html"><span class="logo-wm">PC<em>LAF</em></span><span class="logo-sub">Servicio técnico</span></a><a class="nav-back" href="/index.html">← Volver al inicio</a><a class="nav-wa" href="https://wa.me/5491135708345?text=Hola%2C%20quiero%20consultar%20por%20service%20de%20consola" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></nav><main><section class="hero"><p>PCLAF / SERVICE PREVENTIVO DE CONSOLAS</p><h1>Tu consola,<br /><em>lista para jugar.</em></h1><span>Limpieza y mantenimiento térmico para bajar temperatura, reducir el ruido del cooler y ayudar a prevenir fallas por exceso de calor. Sin reparaciones ni joysticks.</span></section><section class="grid">{consoles.map((console, index) => <a href={`/consolas/${console.slug}.html`}><small>0{index + 1} / SERVICE</small><h2>{console.name}</h2><p>{console.includes}</p><strong>{console.price} ↗</strong></a>)}</section></main><footer><span>© 2026 PCLAF / FLORESTA</span><a href="/precios.html#consolas">Ver precios ↗</a></footer></div>
</SiteLayout>
<style>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Barlow:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');:global(*){box-sizing:border-box}:global(body){margin:0;background:#080808;color:#f0f0f0;font-family:'Barlow',sans-serif}:global(a){color:inherit;text-decoration:none}.hub{--red:#cc0000;--line:#252525;min-height:100vh;background:#080808}.legacy-nav{background:#0f0f0f;border-bottom:2px solid #cc0000;padding:0 24px;height:62px;display:flex;align-items:center;gap:14px;position:sticky;top:0;z-index:10}.nav-logo{display:flex;align-items:center;gap:10px}.logo-wm{font:800 18px 'Barlow Condensed',sans-serif}.logo-wm em{color:#cc0000;font-style:normal}.logo-sub{font:10px 'JetBrains Mono',monospace;color:#444;text-transform:uppercase}.nav-back,.nav-wa{padding:8px 16px;border-radius:6px;font-size:13px;font-weight:700}.nav-back{margin-left:auto;background:#cc0000}.nav-wa{background:#25d366}.hero{padding:clamp(56px,9vw,100px) clamp(20px,8vw,140px) 70px;border-bottom:1px solid var(--line)}.hero>p,.grid small{font:10px 'JetBrains Mono',monospace;letter-spacing:.13em;color:var(--red)}.hero h1{font:900 clamp(48px,8vw,92px)/.9 'Barlow Condensed',sans-serif;margin:25px 0 16px}.hero h1 em{color:var(--red);font-style:normal}.hero span{display:block;max-width:560px;color:#888;font-size:18px;line-height:1.5}.grid{display:grid;grid-template-columns:repeat(2,1fr);margin:0 clamp(20px,8vw,140px);border-left:1px solid var(--line)}.grid a{min-height:210px;padding:28px;background:#0f0f0f;border-right:1px solid var(--line);border-bottom:1px solid var(--line);transition:background .2s}.grid a:hover{background:#161616}.grid h2{font:700 clamp(26px,3vw,43px)/.9 'Barlow Condensed',sans-serif;margin:32px 0 12px}.grid p{color:#888;font-size:14px;line-height:1.45;max-width:340px;margin:0 0 24px}.grid strong{color:var(--red);font:14px 'JetBrains Mono',monospace}.hub footer{display:flex;justify-content:space-between;padding:24px clamp(20px,8vw,140px);color:#444;font:10px 'JetBrains Mono',monospace;text-transform:uppercase;border-top:2px solid var(--red)}.hub footer a{color:#888}@media(max-width:650px){.grid{grid-template-columns:1fr;margin:0 20px}.hero h1{font-size:61px}.nav-wa{display:none}.hub footer{flex-direction:column;gap:14px}}
  .console-main{font-family:'Barlow',sans-serif!important;background:#080808!important;color:#f0f0f0!important}.console-main .hero{background:#0f0f0f!important;border-bottom:2px solid #cc0000!important}.console-main .hero>p,.console-main .grid small{font-family:'JetBrains Mono',monospace!important;color:#cc0000!important}.console-main .hero h1{font-family:'Barlow Condensed',sans-serif!important;font-weight:900!important;letter-spacing:-.02em!important;font-size:clamp(48px,8vw,92px)!important}.console-main .hero h1 em{color:#cc0000!important;font-style:normal!important}.console-main .hero span{color:#888!important;font-size:18px!important}.console-main .grid{border-left:1px solid #252525!important}.console-main .grid a{background:#0f0f0f!important;border-color:#252525!important}.console-main .grid a:hover{background:#161616!important}.console-main .grid h2{font-family:'Barlow Condensed',sans-serif!important;font-weight:700!important;letter-spacing:-.02em!important}.console-main .grid p{color:#888!important}.console-main .grid strong{color:#cc0000!important;font-family:'JetBrains Mono',monospace!important}.console-main footer{background:#0f0f0f!important;border-top:2px solid #cc0000!important;color:#444!important}.console-main footer a{color:#888!important}
</style>
