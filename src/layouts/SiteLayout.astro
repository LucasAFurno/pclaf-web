---
interface Props { title: string; description?: string; }
const { title, description = 'Tecnología que funciona. Personas que responden. PCLAF, Floresta.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111111" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/assets/pclaf-nav.css" />
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>
